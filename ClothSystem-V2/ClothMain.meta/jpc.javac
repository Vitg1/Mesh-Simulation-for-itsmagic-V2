    //[I-S]LN=150;[I-E]
   @Order(idx = 110) //[I-S]LN=151;[I-E]
   private Vertex mesh; //[I-S]LN=152;[I-E]
    //[I-S]LN=153;[I-E]
   @Order(idx = 111) //[I-S]LN=154;[I-E]
   private NativeFloatBuffer vertexBuffer; //[I-S]LN=155;[I-E]
    //[I-S]LN=156;[I-E]
   @Order(idx = 112) //[I-S]LN=157;[I-E]
   private float[] tempVerts; //[I-S]LN=158;[I-E]
    //[I-S]LN=159;[I-E]
   @Order(idx = 113) //[I-S]LN=160;[I-E]
   private Vector3 lastObjectPos = new Vector3(); //[I-S]LN=161;[I-E]
   // ================= RUNTIME — ESTADO ================= //[I-S]LN=162;[I-E]
    //[I-S]LN=163;[I-E]
   @Order(idx = 120) //[I-S]LN=164;[I-E]
   private boolean editorMode; //[I-S]LN=165;[I-E]
    //[I-S]LN=166;[I-E]
   @Order(idx = 121) //[I-S]LN=167;[I-E]
   private boolean meshDirty; //[I-S]LN=168;[I-E]
    //[I-S]LN=169;[I-E]
   @Order(idx = 122) //[I-S]LN=170;[I-E]
   private float windTime; //[I-S]LN=171;[I-E]
    //[I-S]LN=172;[I-E]
   // ================= Editor ================= //[I-S]LN=173;[I-E]
   @Header("Editor") //[I-S]LN=174;[I-E]
    //[I-S]LN=175;[I-E]
   @Order(idx = -100) //[I-S]LN=176;[I-E]
   boolean Editor_Mode; //[I-S]LN=177;[I-E]
    //[I-S]LN=178;[I-E]
   @Order(idx = -90)  //[I-S]LN=179;[I-E]
   private boolean UpdateMesh; //[I-S]LN=180;[I-E]
    //[I-S]LN=181;[I-E]
   @Order(idx = -80) @ShowIf("Editor_Mode") //[I-S]LN=182;[I-E]
   boolean Clearall; //[I-S]LN=183;[I-E]
    //[I-S]LN=184;[I-E]
   @Order(idx = -70) @ShowIf("Editor_Mode") //[I-S]LN=185;[I-E]
   boolean resetPointsPos = false; //[I-S]LN=186;[I-E]
    //[I-S]LN=187;[I-E]
   @Order(idx = -60) @ShowIf("Editor_Mode")  //[I-S]LN=188;[I-E]
   boolean DestroyPointsInPlay = true; //[I-S]LN=189;[I-E]
    //[I-S]LN=190;[I-E]
   private int atualizado; //[I-S]LN=191;[I-E]
   @AutoWired private ModelRenderer mr; //[I-S]LN=192;[I-E]
   private Vector3 pospassado = new Vector3(); //[I-S]LN=193;[I-E]
   private boolean pastcollideMeshes; //[I-S]LN=194;[I-E]
    //[I-S]LN=195;[I-E]
   public void stoppedRepeat() { //[I-S]LN=196;[I-E]
        //[I-S]LN=197;[I-E]
     if (myObject.getChildCount() > 0) { //[I-S]LN=198;[I-E]
       SpatialObject obj = myObject.findChildObject("ponto-" + 0); //[I-S]LN=199;[I-E]
       if (obj != null) Editor_Mode = true; //[I-S]LN=200;[I-E]
       atualizado = 1; //[I-S]LN=201;[I-E]
       clothPoint cp = obj.findComponent(clothPoint.class); //[I-S]LN=202;[I-E]
    //[I-S]LN=203;[I-E]
       /////// gambiarra pra caso os pontos bugarem e forem parar fora do lugar ///////// //[I-S]LN=204;[I-E]
    //[I-S]LN=205;[I-E]
       float eps = 0.0005f; // tolerância do editor //[I-S]LN=206;[I-E]
       if (!collideMeshes) { //[I-S]LN=207;[I-E]
         if (cp.localPosition.sub(obj.getPosition()).length() > eps) { //[I-S]LN=208;[I-E]
           if (!resetPointsPos) { //[I-S]LN=209;[I-E]
             resetPointsPos = true; //[I-S]LN=210;[I-E]
           } //[I-S]LN=211;[I-E]
         } else { //[I-S]LN=212;[I-E]
           resetPointsPos = false; //[I-S]LN=213;[I-E]
         } //[I-S]LN=214;[I-E]
       } else { //[I-S]LN=215;[I-E]
    //[I-S]LN=216;[I-E]
         Vector3 posatual = myObject.getGlobalPosition(); //[I-S]LN=217;[I-E]
    //[I-S]LN=218;[I-E]
         if (pospassado != posatual) { //[I-S]LN=219;[I-E]
           ModelRenderer mr = myObject.findComponent(ModelRenderer.class); //[I-S]LN=220;[I-E]
    //[I-S]LN=221;[I-E]
           mesh = mr.getVertex(); //[I-S]LN=222;[I-E]
           NativeFloatBuffer originalVertexBuf; //[I-S]LN=223;[I-E]
           if (mesh != null) originalVertexBuf = mesh.getVerticesBuffer(); //[I-S]LN=224;[I-E]
           else return; //[I-S]LN=225;[I-E]
    //[I-S]LN=226;[I-E]
           int totalFloats = originalVertexBuf.capacity(); //[I-S]LN=227;[I-E]
           int vertexCount = totalFloats / 3; //[I-S]LN=228;[I-E]
    //[I-S]LN=229;[I-E]
           if (tempVerts == null || tempVerts.length != totalFloats) { //[I-S]LN=230;[I-E]
             tempVerts = new float[totalFloats]; //[I-S]LN=231;[I-E]
           } //[I-S]LN=232;[I-E]
    //[I-S]LN=233;[I-E]
           for (int i = 0; i < vertexCount; i++) { //[I-S]LN=234;[I-E]
    //[I-S]LN=235;[I-E]
             SpatialObject pobj = myObject.findChildObject("ponto-" + i); //[I-S]LN=236;[I-E]
             if (pobj == null) continue; //[I-S]LN=237;[I-E]
    //[I-S]LN=238;[I-E]
             clothPoint p = pobj.findComponent(clothPoint.class); //[I-S]LN=239;[I-E]
             if (p == null) continue; //[I-S]LN=240;[I-E]
    //[I-S]LN=241;[I-E]
             int b = i * 3; //[I-S]LN=242;[I-E]
    //[I-S]LN=243;[I-E]
             // posição original da malha //[I-S]LN=244;[I-E]
             Vector3 local = new Vector3(originalVertexBuf.get(b), originalVertexBuf.get(b + 1), originalVertexBuf.get(b + 2)); //[I-S]LN=245;[I-E]
    //[I-S]LN=246;[I-E]
             Vector3 world = myObject.getTransform().transformPoint(local); //[I-S]LN=247;[I-E]
    //[I-S]LN=248;[I-E]
             // resetar dados do ponto //[I-S]LN=249;[I-E]
             p.localPosition = local; //[I-S]LN=250;[I-E]
             p.position = world; //[I-S]LN=251;[I-E]
             p.previousPosition = world.copy(); //[I-S]LN=252;[I-E]
    //[I-S]LN=253;[I-E]
             pobj.setGlobalPosition(p.position); //[I-S]LN=254;[I-E]
             pobj.getTransform().recalculateMatrices(); //[I-S]LN=255;[I-E]
             pospassado = posatual.copy(); //[I-S]LN=256;[I-E]
           } //[I-S]LN=257;[I-E]
         } //[I-S]LN=258;[I-E]
       } //[I-S]LN=259;[I-E]
     } //[I-S]LN=260;[I-E]
    //[I-S]LN=261;[I-E]
     if (resetPointsPos) { //[I-S]LN=262;[I-E]
       if (resetPointsPos && Editor_Mode) { //[I-S]LN=263;[I-E]
    //[I-S]LN=264;[I-E]
         ModelRenderer mr = myObject.findComponent(ModelRenderer.class); //[I-S]LN=265;[I-E]
         mesh = mr.getVertex(); //[I-S]LN=266;[I-E]
         NativeFloatBuffer originalVertexBuf = mesh.getVerticesBuffer(); //[I-S]LN=267;[I-E]
    //[I-S]LN=268;[I-E]
         int totalFloats = originalVertexBuf.capacity(); //[I-S]LN=269;[I-E]
         int vertexCount = totalFloats / 3; //[I-S]LN=270;[I-E]
    //[I-S]LN=271;[I-E]
         if (tempVerts == null || tempVerts.length != totalFloats) { //[I-S]LN=272;[I-E]
           tempVerts = new float[totalFloats]; //[I-S]LN=273;[I-E]
         } //[I-S]LN=274;[I-E]
    //[I-S]LN=275;[I-E]
         for (int i = 0; i < vertexCount; i++) { //[I-S]LN=276;[I-E]
    //[I-S]LN=277;[I-E]
           SpatialObject pobj = myObject.findChildObject("ponto-" + i); //[I-S]LN=278;[I-E]
           if (pobj == null) continue; //[I-S]LN=279;[I-E]
    //[I-S]LN=280;[I-E]
           clothPoint p = pobj.findComponent(clothPoint.class); //[I-S]LN=281;[I-E]
           if (p == null) continue; //[I-S]LN=282;[I-E]
    //[I-S]LN=283;[I-E]
           int b = i * 3; //[I-S]LN=284;[I-E]
    //[I-S]LN=285;[I-E]
           // posição original da malha //[I-S]LN=286;[I-E]
           Vector3 local = new Vector3(originalVertexBuf.get(b), originalVertexBuf.get(b + 1), originalVertexBuf.get(b + 2)); //[I-S]LN=287;[I-E]
    //[I-S]LN=288;[I-E]
           Vector3 world = myObject.getTransform().transformPoint(local); //[I-S]LN=289;[I-E]
    //[I-S]LN=290;[I-E]
           // resetar dados do ponto //[I-S]LN=291;[I-E]
           p.localPosition = local; //[I-S]LN=292;[I-E]
           p.position = world; //[I-S]LN=293;[I-E]
           p.previousPosition = world.copy(); //[I-S]LN=294;[I-E]
    //[I-S]LN=295;[I-E]
           if (!collideMeshes) pobj.setPosition(myObject.getTransform().inverseTransformPoint(world)); //[I-S]LN=296;[I-E]
           else pobj.setGlobalPosition(p.position); //[I-S]LN=297;[I-E]
    //[I-S]LN=298;[I-E]
           // atualizar malha //[I-S]LN=299;[I-E]
           tempVerts[b] = local.getX(); //[I-S]LN=300;[I-E]
           tempVerts[b + 1] = local.getY(); //[I-S]LN=301;[I-E]
           tempVerts[b + 2] = local.getZ(); //[I-S]LN=302;[I-E]
         } //[I-S]LN=303;[I-E]
    //[I-S]LN=304;[I-E]
         resetPointsPos = false; //[I-S]LN=305;[I-E]
         UpdateMesh = true; //[I-S]LN=306;[I-E]
       } //[I-S]LN=307;[I-E]
     } //[I-S]LN=308;[I-E]
    //[I-S]LN=309;[I-E]
     if (collideMeshes && !Editor_Mode) { //[I-S]LN=310;[I-E]
       Editor_Mode = true; //[I-S]LN=311;[I-E]
      noCollideMeshes=!collideMeshes; //[I-S]LN=312;[I-E]
    //[I-S]LN=313;[I-E]
       atualizado = 0; //[I-S]LN=314;[I-E]
       DestroyPointsInPlay = false; //[I-S]LN=315;[I-E]
     } //[I-S]LN=316;[I-E]
    //[I-S]LN=317;[I-E]
     if ((!collideMeshes && pastcollideMeshes == true) && Editor_Mode) { //[I-S]LN=318;[I-E]
       Clearall = true; //[I-S]LN=319;[I-E]
          noCollideMeshes=!collideMeshes; //[I-S]LN=320;[I-E]
    //[I-S]LN=321;[I-E]
       //   Editor_Mode=false; //[I-S]LN=322;[I-E]
     } //[I-S]LN=323;[I-E]
     if (useAdvancedBendings && !collideMeshes) useAdvancedBendings = false; //[I-S]LN=324;[I-E]
    //[I-S]LN=325;[I-E]
     pastcollideMeshes = collideMeshes; //[I-S]LN=326;[I-E]
    //[I-S]LN=327;[I-E]
     if (Editor_Mode) { //[I-S]LN=328;[I-E]
       // === INICIALIZAÇÃO === //[I-S]LN=329;[I-E]
       if (atualizado == 0) { //[I-S]LN=330;[I-E]
         ModelRenderer mr = myObject.findComponent(ModelRenderer.class); //[I-S]LN=331;[I-E]
         mesh = mr.getVertex(); //[I-S]LN=332;[I-E]
         NativeFloatBuffer originalVertexBuf = mesh.getVerticesBuffer(); //[I-S]LN=333;[I-E]
         int totalFloats = originalVertexBuf.capacity(); //[I-S]LN=334;[I-E]
         int vertexCount = totalFloats / 3; //[I-S]LN=335;[I-E]
    //[I-S]LN=336;[I-E]
         vertexBuffer = new NativeFloatBuffer(totalFloats, NativeFloatBuffer.Precision.FLOAT16); //[I-S]LN=337;[I-E]
         for (int i = 0; i < totalFloats; i++) { //[I-S]LN=338;[I-E]
           vertexBuffer.put(originalVertexBuf.get(i)); //[I-S]LN=339;[I-E]
         } //[I-S]LN=340;[I-E]
         mesh.setVertices(vertexBuffer); // opcional //[I-S]LN=341;[I-E]
    //[I-S]LN=342;[I-E]
         points = new clothPoint[vertexCount]; //[I-S]LN=343;[I-E]
    //[I-S]LN=344;[I-E]
         for (int i = 0; i < vertexCount; i++) { //[I-S]LN=345;[I-E]
           int b = i * 3; //[I-S]LN=346;[I-E]
           Vector3 local = new Vector3(vertexBuffer.get(b), vertexBuffer.get(b + 1), vertexBuffer.get(b + 2)); //[I-S]LN=347;[I-E]
           Vector3 world = myObject.getTransform().transformPoint(local); //[I-S]LN=348;[I-E]
    //[I-S]LN=349;[I-E]
           SpatialObject pobj = new SpatialObject("ponto-" + i); //[I-S]LN=350;[I-E]
    //[I-S]LN=351;[I-E]
           clothPoint p = new clothPoint(); //[I-S]LN=352;[I-E]
           pobj.addComponent(p); //[I-S]LN=353;[I-E]
           p.position = world; //[I-S]LN=354;[I-E]
           p.previousPosition = world.copy(); //[I-S]LN=355;[I-E]
           p.localPosition = local; //[I-S]LN=356;[I-E]
           p.vertexIndex = i; //[I-S]LN=357;[I-E]
           if (!collideMeshes) pobj.setPosition(myObject.getTransform().inverseTransformPoint(p.position)); //[I-S]LN=358;[I-E]
           else pobj.setGlobalPosition(p.position); //[I-S]LN=359;[I-E]
    //[I-S]LN=360;[I-E]
           pobj.setParent(myObject); //[I-S]LN=361;[I-E]
           pobj.getTransform().recalculateMatrices(); //[I-S]LN=362;[I-E]
           points[i] = p; //[I-S]LN=363;[I-E]
         } //[I-S]LN=364;[I-E]
    //[I-S]LN=365;[I-E]
         atualizado = 1; //[I-S]LN=366;[I-E]
       } //[I-S]LN=367;[I-E]
    //[I-S]LN=368;[I-E]
       if (collideMeshes) { //[I-S]LN=369;[I-E]
         enablePhysicsProxies(); //[I-S]LN=370;[I-E]
    //[I-S]LN=371;[I-E]
         if (DestroyPointsInPlay) DestroyPointsInPlay = false; //[I-S]LN=372;[I-E]
       } //[I-S]LN=373;[I-E]
    //[I-S]LN=374;[I-E]
       // === ATUALIZAÇÃO VISUAL === //[I-S]LN=375;[I-E]
       if (!UpdateMesh && points != null) { //[I-S]LN=376;[I-E]
         ModelRenderer mr = myObject.findComponent(ModelRenderer.class); //[I-S]LN=377;[I-E]
         mesh = mr.getVertex(); //[I-S]LN=378;[I-E]
         NativeFloatBuffer originalVertexBuf = mesh.getVerticesBuffer(); //[I-S]LN=379;[I-E]
         int totalFloats = originalVertexBuf.capacity(); //[I-S]LN=380;[I-E]
         int vertexCount = totalFloats / 3; //[I-S]LN=381;[I-E]
    //[I-S]LN=382;[I-E]
         if (vertexBuffer == null) { //[I-S]LN=383;[I-E]
           vertexBuffer = new NativeFloatBuffer(totalFloats, NativeFloatBuffer.Precision.FLOAT16); //[I-S]LN=384;[I-E]
           for (int i = 0; i < totalFloats; i++) { //[I-S]LN=385;[I-E]
             vertexBuffer.put(originalVertexBuf.get(i)); //[I-S]LN=386;[I-E]
           } //[I-S]LN=387;[I-E]
           mesh.setVertices(vertexBuffer); //[I-S]LN=388;[I-E]
         } //[I-S]LN=389;[I-E]
    //[I-S]LN=390;[I-E]
         if (tempVerts == null || tempVerts.length != totalFloats) { //[I-S]LN=391;[I-E]
           tempVerts = new float[totalFloats]; //[I-S]LN=392;[I-E]
         } //[I-S]LN=393;[I-E]
    //[I-S]LN=394;[I-E]
         for (int i = 0; i < vertexCount; i++) { //[I-S]LN=395;[I-E]
           SpatialObject pobj = myObject.findChildObject("ponto-" + i); //[I-S]LN=396;[I-E]
           if (pobj != null) { //[I-S]LN=397;[I-E]
             clothPoint p = pobj.findComponent(clothPoint.class); //[I-S]LN=398;[I-E]
             p.position = pobj.getGlobalPosition(); //[I-S]LN=399;[I-E]
             p.previousPosition = pobj.getGlobalPosition(); //[I-S]LN=400;[I-E]
           } //[I-S]LN=401;[I-E]
         } //[I-S]LN=402;[I-E]
    //[I-S]LN=403;[I-E]
         for (int i = 0; i < vertexCount; i++) { //[I-S]LN=404;[I-E]
           Vector3 local = myObject.getTransform().inverseTransformPoint(points[i].position); //[I-S]LN=405;[I-E]
           int idx = i * 3; //[I-S]LN=406;[I-E]
           tempVerts[idx] = local.getX(); //[I-S]LN=407;[I-E]
           tempVerts[idx + 1] = local.getY(); //[I-S]LN=408;[I-E]
           tempVerts[idx + 2] = local.getZ(); //[I-S]LN=409;[I-E]
         } //[I-S]LN=410;[I-E]
    //[I-S]LN=411;[I-E]
         vertexBuffer.set(tempVerts); //[I-S]LN=412;[I-E]
         mesh.recalculateBoundingBox(); //[I-S]LN=413;[I-E]
         mesh.apply(); //[I-S]LN=414;[I-E]
    //[I-S]LN=415;[I-E]
         UpdateMesh = true; //[I-S]LN=416;[I-E]
       } //[I-S]LN=417;[I-E]
     } //[I-S]LN=418;[I-E]
    //[I-S]LN=419;[I-E]
     if (Clearall) { //[I-S]LN=420;[I-E]
       // === SAÍDA DO MODO EDITOR === //[I-S]LN=421;[I-E]
       for (int i = 0; i < myObject.getChildCount(); i++) { //[I-S]LN=422;[I-E]
         SpatialObject pobj = myObject.findChildObject("ponto-" + i); //[I-S]LN=423;[I-E]
         if (pobj != null) pobj.destroy(); //[I-S]LN=424;[I-E]
       } //[I-S]LN=425;[I-E]
       Editor_Mode = false; //[I-S]LN=426;[I-E]
       Clearall = false; //[I-S]LN=427;[I-E]
       atualizado = 0; //[I-S]LN=428;[I-E]
     } //[I-S]LN=429;[I-E]
   } //[I-S]LN=430;[I-E]
    //[I-S]LN=431;[I-E]
   @Override //[I-S]LN=432;[I-E]
   public void start() { //[I-S]LN=433;[I-E]
    //[I-S]LN=434;[I-E]
     lastObjectPos.set(myObject.getGlobalPosition()); //[I-S]LN=435;[I-E]
    //[I-S]LN=436;[I-E]
     mesh = mr.getVertex(); //[I-S]LN=437;[I-E]
     NativeFloatBuffer src = mesh.getVerticesBuffer(); //[I-S]LN=438;[I-E]
    //[I-S]LN=439;[I-E]
     // =============================== //[I-S]LN=440;[I-E]
     // DETECTAR SE VEIO DO EDITOR //[I-S]LN=441;[I-E]
     // =============================== //[I-S]LN=442;[I-E]
     boolean fromEditor = Editor_Mode; //[I-S]LN=443;[I-E]
    //[I-S]LN=444;[I-E]
     int vCount = src.capacity() / 3; //[I-S]LN=445;[I-E]
    //[I-S]LN=446;[I-E]
     // =============================== //[I-S]LN=447;[I-E]
     // USAR BUFFER ATUAL (EDITOR OU NÃO) //[I-S]LN=448;[I-E]
     // =============================== //[I-S]LN=449;[I-E]
     vertexBuffer = src; //[I-S]LN=450;[I-E]
     tempVerts = new float[src.capacity()]; //[I-S]LN=451;[I-E]
    //[I-S]LN=452;[I-E]
     // =============================== //[I-S]LN=453;[I-E]
     // CAMINHO 1 — VEIO DO EDITOR //[I-S]LN=454;[I-E]
     // =============================== //[I-S]LN=455;[I-E]
     if (fromEditor) { //[I-S]LN=456;[I-E]
    //[I-S]LN=457;[I-E]
       points = new clothPoint[vCount]; //[I-S]LN=458;[I-E]
    //[I-S]LN=459;[I-E]
       for (int i = 0; i < vCount; i++) { //[I-S]LN=460;[I-E]
    //[I-S]LN=461;[I-E]
         SpatialObject pobj = myObject.findChildObject("ponto-" + i); //[I-S]LN=462;[I-E]
         if (pobj == null) continue; //[I-S]LN=463;[I-E]
    //[I-S]LN=464;[I-E]
         clothPoint p = pobj.findComponent(clothPoint.class); //[I-S]LN=465;[I-E]
         if (p == null) continue; //[I-S]LN=466;[I-E]
    //[I-S]LN=467;[I-E]
         // garantir consistência //[I-S]LN=468;[I-E]
         p.vertexIndex = i; //[I-S]LN=469;[I-E]
         p.position = pobj.getGlobalPosition(); //[I-S]LN=470;[I-E]
         p.previousPosition = p.position.copy(); //[I-S]LN=471;[I-E]
    //[I-S]LN=472;[I-E]
         // recalcular local a partir do estado editado //[I-S]LN=473;[I-E]
         p.localPosition = myObject.getTransform().inverseTransformPoint(p.position); //[I-S]LN=474;[I-E]
    //[I-S]LN=475;[I-E]
         points[i] = p; //[I-S]LN=476;[I-E]
         syncPointsFromEditor(); //[I-S]LN=477;[I-E]
       } //[I-S]LN=478;[I-E]
    //[I-S]LN=479;[I-E]
       // limpar gizmos do editor //[I-S]LN=480;[I-E]
       for (int i = 0; i < myObject.getChildCount(); i++) { //[I-S]LN=481;[I-E]
         SpatialObject c = myObject.findChildObject("ponto-" + i); //[I-S]LN=482;[I-E]
         if (c != null) { //[I-S]LN=483;[I-E]
           if (DestroyPointsInPlay) c.destroy(); //[I-S]LN=484;[I-E]
         } //[I-S]LN=485;[I-E]
       } //[I-S]LN=486;[I-E]
    //[I-S]LN=487;[I-E]
     } //[I-S]LN=488;[I-E]
     // =============================== //[I-S]LN=489;[I-E]
     // CAMINHO 2 — SEM EDITOR //[I-S]LN=490;[I-E]
     // =============================== //[I-S]LN=491;[I-E]
     else { //[I-S]LN=492;[I-E]
    //[I-S]LN=493;[I-E]
       points = new clothPoint[vCount]; //[I-S]LN=494;[I-E]
    //[I-S]LN=495;[I-E]
       for (int i = 0; i < vCount; i++) { //[I-S]LN=496;[I-E]
    //[I-S]LN=497;[I-E]
         int b = i * 3; //[I-S]LN=498;[I-E]
    //[I-S]LN=499;[I-E]
         Vector3 local = new Vector3(vertexBuffer.get(b), vertexBuffer.get(b + 1), vertexBuffer.get(b + 2)); //[I-S]LN=500;[I-E]
    //[I-S]LN=501;[I-E]
         Vector3 world = myObject.getTransform().transformPoint(local); //[I-S]LN=502;[I-E]
    //[I-S]LN=503;[I-E]
         clothPoint p = new clothPoint(); //[I-S]LN=504;[I-E]
         p.vertexIndex = i; //[I-S]LN=505;[I-E]
         p.localPosition = local; //[I-S]LN=506;[I-E]
         p.position = world; //[I-S]LN=507;[I-E]
         p.previousPosition = world.copy(); //[I-S]LN=508;[I-E]
    //[I-S]LN=509;[I-E]
         points[i] = p; //[I-S]LN=510;[I-E]
         createPoints(); //[I-S]LN=511;[I-E]
       } //[I-S]LN=512;[I-E]
     } //[I-S]LN=513;[I-E]
    //[I-S]LN=514;[I-E]
     // =============================== //[I-S]LN=515;[I-E]
     // CONSTRAINTS SEMPRE RECRIADAS //[I-S]LN=516;[I-E]
     // =============================== //[I-S]LN=517;[I-E]
     constraints.clear(); //[I-S]LN=518;[I-E]
     createConstraints(); //[I-S]LN=519;[I-E]
    //[I-S]LN=520;[I-E]
     mesh.apply(); //[I-S]LN=521;[I-E]
   } //[I-S]LN=522;[I-E]
    //[I-S]LN=523;[I-E]
   //////// estranho///// //[I-S]LN=524;[I-E]
   private void createConstraints() { //[I-S]LN=525;[I-E]
    //[I-S]LN=526;[I-E]
     NativeIntBuffer tris = mesh.getTrianglesBuffer(); //[I-S]LN=527;[I-E]
     Set<Long> edges = new HashSet<Long>(); //[I-S]LN=528;[I-E]
    //[I-S]LN=529;[I-E]
     // ========= STRUCTURAL ========= //[I-S]LN=530;[I-E]
     for (int i = 0; i < tris.capacity(); i += 3) { //[I-S]LN=531;[I-E]
    //[I-S]LN=532;[I-E]
       int a = tris.get(i); //[I-S]LN=533;[I-E]
       int b = tris.get(i + 1); //[I-S]LN=534;[I-E]
       int c = tris.get(i + 2); //[I-S]LN=535;[I-E]
    //[I-S]LN=536;[I-E]
       addEdge(a, b, edges); //[I-S]LN=537;[I-E]
       addEdge(b, c, edges); //[I-S]LN=538;[I-E]
       addEdge(c, a, edges); //[I-S]LN=539;[I-E]
     } //[I-S]LN=540;[I-E]
     //   createShearConstraints(tris); //[I-S]LN=541;[I-E]
     // ========= BENDING ========= //[I-S]LN=542;[I-E]
     if (Mesh_iterations > 7 && !useAdvancedBendings) { //[I-S]LN=543;[I-E]
       createBendingConstraints(tris); //[I-S]LN=544;[I-E]
     } //[I-S]LN=545;[I-E]
     if (Mesh_iterations > 7 && useAdvancedBendings) { //[I-S]LN=546;[I-E]
       createAdvancedBendingConstraints(tris); //[I-S]LN=547;[I-E]
     } //[I-S]LN=548;[I-E]
    //[I-S]LN=549;[I-E]
     // ========= SEAMS ========= //[I-S]LN=550;[I-E]
     if (seamConstraints) { //[I-S]LN=551;[I-E]
       createSeamConstraints(); //[I-S]LN=552;[I-E]
     } //[I-S]LN=553;[I-E]
   } //[I-S]LN=554;[I-E]
    //[I-S]LN=555;[I-E]
   private void addEdge(int a, int b, Set<Long> edges) { //[I-S]LN=556;[I-E]
    //[I-S]LN=557;[I-E]
     int min = Math.min(a, b); //[I-S]LN=558;[I-E]
     int max = Math.max(a, b); //[I-S]LN=559;[I-E]
    //[I-S]LN=560;[I-E]
     long key = (((long) min) << 32) | (max & 0xffffffffL); //[I-S]LN=561;[I-E]
     if (edges.contains(key)) return; //[I-S]LN=562;[I-E]
    //[I-S]LN=563;[I-E]
     edges.add(key); //[I-S]LN=564;[I-E]
     addConstraint(points[min], points[max], structuralStiffness, ClothConstraint.Type.STRUCTURAL); //[I-S]LN=565;[I-E]
   } //[I-S]LN=566;[I-E]
    //[I-S]LN=567;[I-E]
   private void createSeamConstraints() { //[I-S]LN=568;[I-E]
    //[I-S]LN=569;[I-E]
     Map<Long, Integer> firstAt = new HashMap<Long, Integer>(); //[I-S]LN=570;[I-E]
    //[I-S]LN=571;[I-E]
     for (int i = 0; i < points.length; i++) { //[I-S]LN=572;[I-E]
    //[I-S]LN=573;[I-E]
       Vector3 p = points[i].localPosition; //[I-S]LN=574;[I-E]
    //[I-S]LN=575;[I-E]
       long kx = (long) (p.getX() * 100000f); //[I-S]LN=576;[I-E]
       long ky = (long) (p.getY() * 100000f); //[I-S]LN=577;[I-E]
       long kz = (long) (p.getZ() * 100000f); //[I-S]LN=578;[I-E]
    //[I-S]LN=579;[I-E]
       long key = (kx & 0x1fffffL) << 42 | (ky & 0x1fffffL) << 21 | (kz & 0x1fffffL); //[I-S]LN=580;[I-E]
    //[I-S]LN=581;[I-E]
       if (!firstAt.containsKey(key)) { //[I-S]LN=582;[I-E]
    //[I-S]LN=583;[I-E]
         firstAt.put(key, i); //[I-S]LN=584;[I-E]
    //[I-S]LN=585;[I-E]
       } else { //[I-S]LN=586;[I-E]
    //[I-S]LN=587;[I-E]
         int currentMaster = firstAt.get(key); //[I-S]LN=588;[I-E]
    //[I-S]LN=589;[I-E]
         // Se o ponto atual for fixo e o master não for, troca //[I-S]LN=590;[I-E]
         if (points[i].isFixed && !points[currentMaster].isFixed) { //[I-S]LN=591;[I-E]
           firstAt.put(key, i); //[I-S]LN=592;[I-E]
           currentMaster = i; //[I-S]LN=593;[I-E]
         } //[I-S]LN=594;[I-E]
    //[I-S]LN=595;[I-E]
         addConstraint(points[currentMaster], points[i], seamStiffness, ClothConstraint.Type.STRUCTURAL); //[I-S]LN=596;[I-E]
    //[I-S]LN=597;[I-E]
         if (collideMeshes) { //[I-S]LN=598;[I-E]
           SpatialObject slaveObj = myObject.findChildObject("ponto-" + i); //[I-S]LN=599;[I-E]
           if (slaveObj != null) { //[I-S]LN=600;[I-E]
             Collider col = slaveObj.findComponent(Collider.class); //[I-S]LN=601;[I-E]
             if (col != null) col.setEnabled(false); //[I-S]LN=602;[I-E]
           } //[I-S]LN=603;[I-E]
         } //[I-S]LN=604;[I-E]
       } //[I-S]LN=605;[I-E]
     } //[I-S]LN=606;[I-E]
   } //[I-S]LN=607;[I-E]
    //[I-S]LN=608;[I-E]
   private void createBendingConstraints(NativeIntBuffer tris) { //[I-S]LN=609;[I-E]
    //[I-S]LN=610;[I-E]
     Map<Long, int[]> edgeToTri = new HashMap<Long, int[]>(); //[I-S]LN=611;[I-E]
    //[I-S]LN=612;[I-E]
     // mapear arestas → triângulos //[I-S]LN=613;[I-E]
     for (int i = 0; i < tris.capacity(); i += 3) { //[I-S]LN=614;[I-E]
    //[I-S]LN=615;[I-E]
       int a = tris.get(i); //[I-S]LN=616;[I-E]
       int b = tris.get(i + 1); //[I-S]LN=617;[I-E]
       int c = tris.get(i + 2); //[I-S]LN=618;[I-E]
    //[I-S]LN=619;[I-E]
       mapEdge(edgeToTri, a, b, i); //[I-S]LN=620;[I-E]
       mapEdge(edgeToTri, b, c, i); //[I-S]LN=621;[I-E]
       mapEdge(edgeToTri, c, a, i); //[I-S]LN=622;[I-E]
     } //[I-S]LN=623;[I-E]
    //[I-S]LN=624;[I-E]
     // criar bending //[I-S]LN=625;[I-E]
     for (Map.Entry<Long, int[]> e : edgeToTri.entrySet()) { //[I-S]LN=626;[I-E]
    //[I-S]LN=627;[I-E]
       int[] ts = e.getValue(); //[I-S]LN=628;[I-E]
       if (ts[1] == -1) continue; //[I-S]LN=629;[I-E]
    //[I-S]LN=630;[I-E]
       int t1 = ts[0]; //[I-S]LN=631;[I-E]
       int t2 = ts[1]; //[I-S]LN=632;[I-E]
    //[I-S]LN=633;[I-E]
       int a1 = tris.get(t1); //[I-S]LN=634;[I-E]
       int b1 = tris.get(t1 + 1); //[I-S]LN=635;[I-E]
       int c1 = tris.get(t1 + 2); //[I-S]LN=636;[I-E]
    //[I-S]LN=637;[I-E]
       int a2 = tris.get(t2); //[I-S]LN=638;[I-E]
       int b2 = tris.get(t2 + 1); //[I-S]LN=639;[I-E]
       int c2 = tris.get(t2 + 2); //[I-S]LN=640;[I-E]
    //[I-S]LN=641;[I-E]
       int[] shared = sharedEdge(a1, b1, c1, a2, b2, c2); //[I-S]LN=642;[I-E]
       if (shared == null) continue; //[I-S]LN=643;[I-E]
    //[I-S]LN=644;[I-E]
       int o1 = opposite(a1, b1, c1, shared[0], shared[1]); //[I-S]LN=645;[I-E]
       int o2 = opposite(a2, b2, c2, shared[0], shared[1]); //[I-S]LN=646;[I-E]
    //[I-S]LN=647;[I-E]
       if (o1 != -1 && o2 != -1) { //[I-S]LN=648;[I-E]
         addConstraint(points[o1], points[o2], bendingStiffness, ClothConstraint.Type.BENDING); //[I-S]LN=649;[I-E]
       } //[I-S]LN=650;[I-E]
     } //[I-S]LN=651;[I-E]
   } //[I-S]LN=652;[I-E]
    //[I-S]LN=653;[I-E]
   private void createShearConstraints(NativeIntBuffer tris) { //[I-S]LN=654;[I-E]
    //[I-S]LN=655;[I-E]
     Map<Long, int[]> edgeToTri = new HashMap<Long, int[]>(); //[I-S]LN=656;[I-E]
    //[I-S]LN=657;[I-E]
     // mapear arestas → triângulos //[I-S]LN=658;[I-E]
     for (int i = 0; i < tris.capacity(); i += 3) { //[I-S]LN=659;[I-E]
    //[I-S]LN=660;[I-E]
       int a = tris.get(i); //[I-S]LN=661;[I-E]
       int b = tris.get(i + 1); //[I-S]LN=662;[I-E]
       int c = tris.get(i + 2); //[I-S]LN=663;[I-E]
    //[I-S]LN=664;[I-E]
       mapEdge(edgeToTri, a, b, i); //[I-S]LN=665;[I-E]
       mapEdge(edgeToTri, b, c, i); //[I-S]LN=666;[I-E]
       mapEdge(edgeToTri, c, a, i); //[I-S]LN=667;[I-E]
     } //[I-S]LN=668;[I-E]
    //[I-S]LN=669;[I-E]
     // criar bending //[I-S]LN=670;[I-E]
     for (Map.Entry<Long, int[]> e : edgeToTri.entrySet()) { //[I-S]LN=671;[I-E]
    //[I-S]LN=672;[I-E]
       int[] ts = e.getValue(); //[I-S]LN=673;[I-E]
       if (ts[1] == -1) continue; //[I-S]LN=674;[I-E]
    //[I-S]LN=675;[I-E]
       int t1 = ts[0]; //[I-S]LN=676;[I-E]
       int t2 = ts[1]; //[I-S]LN=677;[I-E]
    //[I-S]LN=678;[I-E]
       int a1 = tris.get(t1); //[I-S]LN=679;[I-E]
       int b1 = tris.get(t1 + 1); //[I-S]LN=680;[I-E]
       int c1 = tris.get(t1 + 2); //[I-S]LN=681;[I-E]
    //[I-S]LN=682;[I-E]
       int a2 = tris.get(t2); //[I-S]LN=683;[I-E]
       int b2 = tris.get(t2 + 1); //[I-S]LN=684;[I-E]
       int c2 = tris.get(t2 + 2); //[I-S]LN=685;[I-E]
    //[I-S]LN=686;[I-E]
       int[] shared = sharedEdge(a1, b1, c1, a2, b2, c2); //[I-S]LN=687;[I-E]
       if (shared == null) continue; //[I-S]LN=688;[I-E]
    //[I-S]LN=689;[I-E]
       int o1 = opposite(a1, b1, c1, shared[0], shared[1]); //[I-S]LN=690;[I-E]
       int o2 = opposite(a2, b2, c2, shared[0], shared[1]); //[I-S]LN=691;[I-E]
    //[I-S]LN=692;[I-E]
       // ========================================================== //[I-S]LN=693;[I-E]
       // 2. NOVO: Constraint de SHEAR (Reforço Cruzado) //[I-S]LN=694;[I-E]
       // ========================================================== //[I-S]LN=695;[I-E]
       // Isso conecta as pontas opostas com uma mola MAIS DURA que o bending, //[I-S]LN=696;[I-E]
       // mas um pouco mais mole que o structural. //[I-S]LN=697;[I-E]
       // Isso impede que os dois triângulos se separem excessivamente. //[I-S]LN=698;[I-E]
    //[I-S]LN=699;[I-E]
       float shearStiffness = structuralStiffness * 0.7f; // Ex: 50% da rigidez estrutural //[I-S]LN=700;[I-E]
       addConstraint(points[o1], points[o2], shearStiffness, ClothConstraint.Type.SHEAR); //[I-S]LN=701;[I-E]
     } //[I-S]LN=702;[I-E]
   } //[I-S]LN=703;[I-E]
    //[I-S]LN=704;[I-E]
   private void createAdvancedBendingConstraints(NativeIntBuffer tris) { //[I-S]LN=705;[I-E]
    //[I-S]LN=706;[I-E]
     Map<Long, int[]> edgeToTri = new HashMap<Long, int[]>(); //[I-S]LN=707;[I-E]
    //[I-S]LN=708;[I-E]
     // mapear arestas → triângulos //[I-S]LN=709;[I-E]
     for (int i = 0; i < tris.capacity(); i += 3) { //[I-S]LN=710;[I-E]
    //[I-S]LN=711;[I-E]
       int a = tris.get(i); //[I-S]LN=712;[I-E]
       int b = tris.get(i + 1); //[I-S]LN=713;[I-E]
       int c = tris.get(i + 2); //[I-S]LN=714;[I-E]
    //[I-S]LN=715;[I-E]
       mapEdge(edgeToTri, a, b, i); //[I-S]LN=716;[I-E]
       mapEdge(edgeToTri, b, c, i); //[I-S]LN=717;[I-E]
       mapEdge(edgeToTri, c, a, i); //[I-S]LN=718;[I-E]
     } //[I-S]LN=719;[I-E]
    //[I-S]LN=720;[I-E]
     // criar bending //[I-S]LN=721;[I-E]
     for (Map.Entry<Long, int[]> e : edgeToTri.entrySet()) { //[I-S]LN=722;[I-E]
    //[I-S]LN=723;[I-E]
       int[] ts = e.getValue(); //[I-S]LN=724;[I-E]
       if (ts[1] == -1) continue; //[I-S]LN=725;[I-E]
    //[I-S]LN=726;[I-E]
       int t1 = ts[0]; //[I-S]LN=727;[I-E]
       int t2 = ts[1]; //[I-S]LN=728;[I-E]
    //[I-S]LN=729;[I-E]
       int a1 = tris.get(t1); //[I-S]LN=730;[I-E]
       int b1 = tris.get(t1 + 1); //[I-S]LN=731;[I-E]
       int c1 = tris.get(t1 + 2); //[I-S]LN=732;[I-E]
    //[I-S]LN=733;[I-E]
       int a2 = tris.get(t2); //[I-S]LN=734;[I-E]
       int b2 = tris.get(t2 + 1); //[I-S]LN=735;[I-E]
       int c2 = tris.get(t2 + 2); //[I-S]LN=736;[I-E]
    //[I-S]LN=737;[I-E]
       int[] shared = sharedEdge(a1, b1, c1, a2, b2, c2); //[I-S]LN=738;[I-E]
       if (shared == null) continue; //[I-S]LN=739;[I-E]
    //[I-S]LN=740;[I-E]
       int o1 = opposite(a1, b1, c1, shared[0], shared[1]); //[I-S]LN=741;[I-E]
       int o2 = opposite(a2, b2, c2, shared[0], shared[1]); //[I-S]LN=742;[I-E]
    //[I-S]LN=743;[I-E]
       // No seu loop de criação de bending: //[I-S]LN=744;[I-E]
       if (o1 != -1 && o2 != -1) { //[I-S]LN=745;[I-E]
         // shared[0], shared[1] -> p1, p2 (Aresta) //[I-S]LN=746;[I-E]
         // o1 -> p3 (Ponta 1) //[I-S]LN=747;[I-E]
         // o2 -> p4 (Ponta 2) //[I-S]LN=748;[I-E]
         addBendingConstraintAdvanced(points[shared[0]], points[shared[1]], points[o1], points[o2], bendingStiffness); //[I-S]LN=749;[I-E]
       } //[I-S]LN=750;[I-E]
     } //[I-S]LN=751;[I-E]
   } //[I-S]LN=752;[I-E]
    //[I-S]LN=753;[I-E]
   private void mapEdge(Map<Long, int[]> map, int a, int b, int tri) { //[I-S]LN=754;[I-E]
    //[I-S]LN=755;[I-E]
     int min = Math.min(a, b); //[I-S]LN=756;[I-E]
     int max = Math.max(a, b); //[I-S]LN=757;[I-E]
     long key = (((long) min) << 32) | (max & 0xffffffffL); //[I-S]LN=758;[I-E]
    //[I-S]LN=759;[I-E]
     int[] t = map.get(key); //[I-S]LN=760;[I-E]
     if (t == null) { //[I-S]LN=761;[I-E]
       map.put(key, new int[] {tri, -1}); //[I-S]LN=762;[I-E]
     } else { //[I-S]LN=763;[I-E]
       t[1] = tri; //[I-S]LN=764;[I-E]
     } //[I-S]LN=765;[I-E]
   } //[I-S]LN=766;[I-E]
    //[I-S]LN=767;[I-E]
   private int[] sharedEdge(int a1, int b1, int c1, int a2, int b2, int c2) { //[I-S]LN=768;[I-E]
     int[] s = new int[2]; //[I-S]LN=769;[I-E]
     int n = 0; //[I-S]LN=770;[I-E]
    //[I-S]LN=771;[I-E]
     int[] t1 = {a1, b1, c1}; //[I-S]LN=772;[I-E]
     int[] t2 = {a2, b2, c2}; //[I-S]LN=773;[I-E]
    //[I-S]LN=774;[I-E]
     for (int i : t1) for (int j : t2) if (i == j && n < 2) s[n++] = i; //[I-S]LN=775;[I-E]
    //[I-S]LN=776;[I-E]
     return n == 2 ? s : null; //[I-S]LN=777;[I-E]
   } //[I-S]LN=778;[I-E]
    //[I-S]LN=779;[I-E]
   private int opposite(int a, int b, int c, int e1, int e2) { //[I-S]LN=780;[I-E]
     if (a != e1 && a != e2) return a; //[I-S]LN=781;[I-E]
     if (b != e1 && b != e2) return b; //[I-S]LN=782;[I-E]
     if (c != e1 && c != e2) return c; //[I-S]LN=783;[I-E]
     return -1; //[I-S]LN=784;[I-E]
   } //[I-S]LN=785;[I-E]
    //[I-S]LN=786;[I-E]
   private void createPoints() { //[I-S]LN=787;[I-E]
    //[I-S]LN=788;[I-E]
     Vector3 min = new Vector3(Float.MAX_VALUE, 0, Float.MAX_VALUE); //[I-S]LN=789;[I-E]
     Vector3 max = new Vector3(Float.MIN_VALUE, 0, Float.MIN_VALUE); //[I-S]LN=790;[I-E]
    //[I-S]LN=791;[I-E]
     for (int i = 0; i < points.length; i++) { //[I-S]LN=792;[I-E]
       int b = i * 3; //[I-S]LN=793;[I-E]
       Vector3 local = new Vector3(vertexBuffer.get(b), vertexBuffer.get(b + 1), vertexBuffer.get(b + 2)); //[I-S]LN=794;[I-E]
    //[I-S]LN=795;[I-E]
       min.set(Math.min(min.getX(), local.getX()), 0, Math.min(min.getZ(), local.getZ())); //[I-S]LN=796;[I-E]
       max.set(Math.max(max.getX(), local.getX()), 0, Math.max(max.getZ(), local.getZ())); //[I-S]LN=797;[I-E]
     } //[I-S]LN=798;[I-E]
    //[I-S]LN=799;[I-E]
     float eps = 0.001f; //[I-S]LN=800;[I-E]
    //[I-S]LN=801;[I-E]
     for (int i = 0; i < points.length; i++) { //[I-S]LN=802;[I-E]
    //[I-S]LN=803;[I-E]
       int b = i * 3; //[I-S]LN=804;[I-E]
       Vector3 local = new Vector3(vertexBuffer.get(b), vertexBuffer.get(b + 1), vertexBuffer.get(b + 2)); //[I-S]LN=805;[I-E]
    //[I-S]LN=806;[I-E]
       Vector3 world = myObject.getTransform().transformPoint(local); //[I-S]LN=807;[I-E]
    //[I-S]LN=808;[I-E]
       clothPoint p = new clothPoint(); //[I-S]LN=809;[I-E]
       p.vertexIndex = i; //[I-S]LN=810;[I-E]
       p.position = world; //[I-S]LN=811;[I-E]
       p.previousPosition = world.copy(); //[I-S]LN=812;[I-E]
       p.localPosition = local; //[I-S]LN=813;[I-E]
    //[I-S]LN=814;[I-E]
       boolean fixed = (fixLeft && Math.abs(local.getX() - min.getX()) < eps) || (fixRight && Math.abs(local.getX() - max.getX()) < eps) || (fixTop && Math.abs(local.getZ() - max.getZ()) < eps) || (fixBottom && Math.abs(local.getZ() - min.getZ()) < eps); //[I-S]LN=815;[I-E]
    //[I-S]LN=816;[I-E]
       p.isFixed = fixed; //[I-S]LN=817;[I-E]
       points[i] = p; //[I-S]LN=818;[I-E]
     } //[I-S]LN=819;[I-E]
   } //[I-S]LN=820;[I-E]
    //[I-S]LN=821;[I-E]
   private void syncPointsFromEditor() { //[I-S]LN=822;[I-E]
    //[I-S]LN=823;[I-E]
     int vCount = vertexBuffer.capacity() / 3; //[I-S]LN=824;[I-E]
     points = new clothPoint[vCount]; //[I-S]LN=825;[I-E]
    //[I-S]LN=826;[I-E]
     Vector3 min = new Vector3(Float.MAX_VALUE, 0, Float.MAX_VALUE); //[I-S]LN=827;[I-E]
     Vector3 max = new Vector3(Float.MIN_VALUE, 0, Float.MIN_VALUE); //[I-S]LN=828;[I-E]
    //[I-S]LN=829;[I-E]
     // === calcular bounds a partir do estado EDITADO === //[I-S]LN=830;[I-E]
     for (int i = 0; i < vCount; i++) { //[I-S]LN=831;[I-E]
       SpatialObject pobj = myObject.findChildObject("ponto-" + i); //[I-S]LN=832;[I-E]
       if (pobj == null) continue; //[I-S]LN=833;[I-E]
    //[I-S]LN=834;[I-E]
       Vector3 local = myObject.getTransform().inverseTransformPoint(pobj.getGlobalPosition()); //[I-S]LN=835;[I-E]
    //[I-S]LN=836;[I-E]
       min.set(Math.min(min.getX(), local.getX()), 0, Math.min(min.getZ(), local.getZ())); //[I-S]LN=837;[I-E]
    //[I-S]LN=838;[I-E]
       max.set(Math.max(max.getX(), local.getX()), 0, Math.max(max.getZ(), local.getZ())); //[I-S]LN=839;[I-E]
     } //[I-S]LN=840;[I-E]
    //[I-S]LN=841;[I-E]
     float eps = 0.001f; //[I-S]LN=842;[I-E]
    //[I-S]LN=843;[I-E]
     // === sincronizar pontos === //[I-S]LN=844;[I-E]
     for (int i = 0; i < vCount; i++) { //[I-S]LN=845;[I-E]
    //[I-S]LN=846;[I-E]
       SpatialObject pobj = myObject.findChildObject("ponto-" + i); //[I-S]LN=847;[I-E]
       if (pobj == null) continue; //[I-S]LN=848;[I-E]
    //[I-S]LN=849;[I-E]
       clothPoint p = pobj.findComponent(clothPoint.class); //[I-S]LN=850;[I-E]
       if (p == null) continue; //[I-S]LN=851;[I-E]
    //[I-S]LN=852;[I-E]
       Vector3 world = pobj.getGlobalPosition(); //[I-S]LN=853;[I-E]
       Vector3 local = myObject.getTransform().inverseTransformPoint(world); //[I-S]LN=854;[I-E]
    //[I-S]LN=855;[I-E]
       p.vertexIndex = i; //[I-S]LN=856;[I-E]
       p.position = world; //[I-S]LN=857;[I-E]
       p.previousPosition = world.copy(); //[I-S]LN=858;[I-E]
       p.localPosition = local; //[I-S]LN=859;[I-E]
    //[I-S]LN=860;[I-E]
       // 🔥 só aplica fix automático se NÃO estiver fixado manualmente //[I-S]LN=861;[I-E]
       if (!p.isFixed) { //[I-S]LN=862;[I-E]
    //[I-S]LN=863;[I-E]
         boolean fixed = (fixLeft && Math.abs(local.getX() - min.getX()) < eps) || (fixRight && Math.abs(local.getX() - max.getX()) < eps) || (fixTop && Math.abs(local.getZ() - max.getZ()) < eps) || (fixBottom && Math.abs(local.getZ() - min.getZ()) < eps); //[I-S]LN=864;[I-E]
    //[I-S]LN=865;[I-E]
         p.isFixed = fixed; //[I-S]LN=866;[I-E]
       } //[I-S]LN=867;[I-E]
    //[I-S]LN=868;[I-E]
       points[i] = p; //[I-S]LN=869;[I-E]
     } //[I-S]LN=870;[I-E]
   } //[I-S]LN=871;[I-E]
    //[I-S]LN=872;[I-E]
   ////////////////// q agonia de codigo slk //[I-S]LN=873;[I-E]
   @Override //[I-S]LN=874;[I-E]
   public void repeat() { //[I-S]LN=875;[I-E]
    //[I-S]LN=876;[I-E]
     // ===== FOLLOW OBJECT ===== //[I-S]LN=877;[I-E]
     Vector3 cur = myObject.getTransform().getGlobalPosition(); //[I-S]LN=878;[I-E]
     Vector3 delta = cur.sub(lastObjectPos); //[I-S]LN=879;[I-E]
    //[I-S]LN=880;[I-E]
     if (delta.getX() != 0 || delta.getY() != 0 || delta.getZ() != 0) { //[I-S]LN=881;[I-E]
       for (clothPoint p : points) { //[I-S]LN=882;[I-E]
         if (p == null) continue; //[I-S]LN=883;[I-E]
         if (p.rb == null) { //[I-S]LN=884;[I-E]
           p.position = p.position.sum(delta); //[I-S]LN=885;[I-E]
           p.previousPosition = p.previousPosition.sum(delta); //[I-S]LN=886;[I-E]
         } else { //[I-S]LN=887;[I-E]
           p.myObject.position = p.myObject.position.sum(delta); //[I-S]LN=888;[I-E]
           p.previousPosition = p.previousPosition.sum(delta); //[I-S]LN=889;[I-E]
         } //[I-S]LN=890;[I-E]
       } //[I-S]LN=891;[I-E]
     } //[I-S]LN=892;[I-E]
     myObject.getTransform().recalculateMatrices(); //[I-S]LN=893;[I-E]
     lastObjectPos.set(cur); //[I-S]LN=894;[I-E]
    //[I-S]LN=895;[I-E]
     if (points == null || points.length == 0) return; //[I-S]LN=896;[I-E]
     windTime += Time.deltaTime; //[I-S]LN=897;[I-E]
    //[I-S]LN=898;[I-E]
     // === INTEGRA CLOTH === //[I-S]LN=899;[I-E]
     Vector3 g = new Vector3(0, gravity, 0); //[I-S]LN=900;[I-E]
     //[I-S]LN=901;[I-E]
     //[I-S]LN=902;[I-E]
       for (ClothConstraint c : constraints) { //[I-S]LN=903;[I-E]
         c.lambdaAccum = 0f; //[I-S]LN=904;[I-E]
       } //[I-S]LN=905;[I-E]
        //[I-S]LN=906;[I-E]
     for (clothPoint p : points) { //[I-S]LN=907;[I-E]
     //[I-S]LN=908;[I-E]
         if (p == null || (p.isFixed && !collideMeshes)) continue; //[I-S]LN=909;[I-E]
    //[I-S]LN=910;[I-E]
         p.applyForce(g.mul(mass)); //[I-S]LN=911;[I-E]
         if (enableWind) applyWind(p); //[I-S]LN=912;[I-E]
         if (!useFixedTimeStep) p.simulate(Time.deltaTime, damping,airDrag); //[I-S]LN=913;[I-E]
         else p.simulate(timeStep, damping,airDrag); //[I-S]LN=914;[I-E]
         //[I-S]LN=915;[I-E]
       } //[I-S]LN=916;[I-E]
    //[I-S]LN=917;[I-E]
       // === CONSTRAINTS === //[I-S]LN=918;[I-E]
       // 2️⃣ Resolve as iterações dentro deste micro-passo //[I-S]LN=919;[I-E]
       for (int i = 0; i < Mesh_iterations; i++) { //[I-S]LN=920;[I-E]
    //[I-S]LN=921;[I-E]
         for (ClothConstraint c : constraints) { //[I-S]LN=922;[I-E]
           c.satisfy(RB_compliance, RB_beta, RB_slop, RB_dampingCoefficient, Internalfriction, yieldStrain, plasticRate, maxPlasticStrain, hardening, timeStep,Time.deltaTime,useFixedTimeStep); //[I-S]LN=923;[I-E]
         } //[I-S]LN=924;[I-E]
       } //[I-S]LN=925;[I-E]
    //[I-S]LN=926;[I-E]
       // ===== COLLISIONS ===== //[I-S]LN=927;[I-E]
      //[I-S]LN=928;[I-E]
        if (!boxColliders.isEmpty()) collideBoxes(); //[I-S]LN=929;[I-E]
       if (!sphereColliders.isEmpty()) collideSpheres(); //[I-S]LN=930;[I-E]
    //[I-S]LN=931;[I-E]
     // ===== UPDATE MESH ===== //[I-S]LN=932;[I-E]
     updateVertexPositions(); //[I-S]LN=933;[I-E]
   } //[I-S]LN=934;[I-E]
    //[I-S]LN=935;[I-E]
   private void updateVertexPositions() { //[I-S]LN=936;[I-E]
    //[I-S]LN=937;[I-E]
     for (int i = 0; i < points.length; i++) { //[I-S]LN=938;[I-E]
       if (points[i].rb == null) { //[I-S]LN=939;[I-E]
    //[I-S]LN=940;[I-E]
         Vector3 local = myObject.getTransform().inverseTransformPoint(points[i].position); //[I-S]LN=941;[I-E]
    //[I-S]LN=942;[I-E]
         int b = i * 3; //[I-S]LN=943;[I-E]
         tempVerts[b] = local.getX(); //[I-S]LN=944;[I-E]
         tempVerts[b + 1] = local.getY(); //[I-S]LN=945;[I-E]
         tempVerts[b + 2] = local.getZ(); //[I-S]LN=946;[I-E]
    //[I-S]LN=947;[I-E]
       } else { //[I-S]LN=948;[I-E]
    //[I-S]LN=949;[I-E]
         // ERRO ANTERIOR: usar points[i].position //[I-S]LN=950;[I-E]
         // CORREÇÃO: usar a posição global real do objeto que o RB moveu //[I-S]LN=951;[I-E]
         Vector3 globalPos = points[i].myObject.getGlobalPosition(); //[I-S]LN=952;[I-E]
         Vector3 local = myObject.getTransform().inverseTransformPoint(globalPos); //[I-S]LN=953;[I-E]
    //[I-S]LN=954;[I-E]
         int b = i * 3; //[I-S]LN=955;[I-E]
         tempVerts[b] = local.getX(); //[I-S]LN=956;[I-E]
         tempVerts[b + 1] = local.getY(); //[I-S]LN=957;[I-E]
         tempVerts[b + 2] = local.getZ(); //[I-S]LN=958;[I-E]
       } //[I-S]LN=959;[I-E]
     } //[I-S]LN=960;[I-E]
    //[I-S]LN=961;[I-E]
     vertexBuffer.set(tempVerts); //[I-S]LN=962;[I-E]
     mesh.apply(); // pesado, mas 1x só //[I-S]LN=963;[I-E]
   } //[I-S]LN=964;[I-E]
    //[I-S]LN=965;[I-E]
   /////////// vento //////////// //[I-S]LN=966;[I-E]
    //[I-S]LN=967;[I-E]
   private void addConstraint(clothPoint p1, clothPoint p2, float stiffness, ClothConstraint.Type type) { //[I-S]LN=968;[I-E]
     ClothConstraint c = new ClothConstraint(); //[I-S]LN=969;[I-E]
    //[I-S]LN=970;[I-E]
     c.p1 = p1; //[I-S]LN=971;[I-E]
     c.p2 = p2; //[I-S]LN=972;[I-E]
     c.stiffness = stiffness; //[I-S]LN=973;[I-E]
     c.type = type; //[I-S]LN=974;[I-E]
    //[I-S]LN=975;[I-E]
     c.start(); // calcula restLength, etc //[I-S]LN=976;[I-E]
    //[I-S]LN=977;[I-E]
     constraints.add(c); //[I-S]LN=978;[I-E]
   } //[I-S]LN=979;[I-E]
    //[I-S]LN=980;[I-E]
   private void addBendingConstraintAdvanced(clothPoint edge1, clothPoint edge2, clothPoint tip1, clothPoint tip2, float stiffness) { //[I-S]LN=981;[I-E]
     ClothConstraint c = new ClothConstraint(); //[I-S]LN=982;[I-E]
    //[I-S]LN=983;[I-E]
     // Aresta compartilhada (a dobradiça) //[I-S]LN=984;[I-E]
     c.p1 = edge1; //[I-S]LN=985;[I-E]
     c.p2 = edge2; //[I-S]LN=986;[I-E]
    //[I-S]LN=987;[I-E]
     // Pontos opostos (as abas que dobram) //[I-S]LN=988;[I-E]
     c.p3 = tip1; //[I-S]LN=989;[I-E]
     c.p4 = tip2; //[I-S]LN=990;[I-E]
    //[I-S]LN=991;[I-E]
     c.stiffness = stiffness; //[I-S]LN=992;[I-E]
     c.type = ClothConstraint.Type.BENDING_ADVANCED; //[I-S]LN=993;[I-E]
    //[I-S]LN=994;[I-E]
     // No start(), ele vai calcular o restAngleValue em vez do restLength //[I-S]LN=995;[I-E]
     c.start(); //[I-S]LN=996;[I-E]
    //[I-S]LN=997;[I-E]
     constraints.add(c); //[I-S]LN=998;[I-E]
   } //[I-S]LN=999;[I-E]
    //[I-S]LN=1000;[I-E]
   /////////// vento //////////// //[I-S]LN=1001;[I-E]
   private float simpleNoise(float x, float y, float z) { //[I-S]LN=1002;[I-E]
    //[I-S]LN=1003;[I-E]
     float v = (float) Math.sin(x * 12.9898f + y * 78.233f + z * 37.719f) * 43758.5453f; //[I-S]LN=1004;[I-E]
    //[I-S]LN=1005;[I-E]
     return v - (int) v; // fract //[I-S]LN=1006;[I-E]
   } //[I-S]LN=1007;[I-E]
    //[I-S]LN=1008;[I-E]
   private void applyWind(clothPoint p) { //[I-S]LN=1009;[I-E]
    //[I-S]LN=1010;[I-E]
     float n = simpleNoise(p.position.getX() * 0.1f, 0, windTime * 0.5f); //[I-S]LN=1011;[I-E]
    //[I-S]LN=1012;[I-E]
     Vector3 dir = windDir.sum(new Vector3(n, n * 0.3f, n)).normalize(); //[I-S]LN=1013;[I-E]
    //[I-S]LN=1014;[I-E]
     Vector3 f = dir.mul(windStrength * (1f + turbulence * n)); //[I-S]LN=1015;[I-E]
     p.applyForce(f); //[I-S]LN=1016;[I-E]
   } //[I-S]LN=1017;[I-E]
    //[I-S]LN=1018;[I-E]
   ///////// colisoes ///////////////// //[I-S]LN=1019;[I-E]
   private void collideBoxes() { //[I-S]LN=1020;[I-E]
    //[I-S]LN=1021;[I-E]
     for (SpatialObject box : boxColliders) { //[I-S]LN=1022;[I-E]
    //[I-S]LN=1023;[I-E]
       Vector3 center = box.getTransform().getGlobalPosition(); //[I-S]LN=1024;[I-E]
       Vector3 half = box.getTransform().getGlobalScale().mul(0.53f); //[I-S]LN=1025;[I-E]
    //[I-S]LN=1026;[I-E]
       Vector3 min = center.sub(half); //[I-S]LN=1027;[I-E]
       Vector3 max = center.sum(half); //[I-S]LN=1028;[I-E]
    //[I-S]LN=1029;[I-E]
       for (clothPoint p : points) { //[I-S]LN=1030;[I-E]
    //[I-S]LN=1031;[I-E]
         if (p.isFixed) continue; //[I-S]LN=1032;[I-E]
    //[I-S]LN=1033;[I-E]
         Vector3 pos = p.position; //[I-S]LN=1034;[I-E]
    //[I-S]LN=1035;[I-E]
         if (pos.getX() < min.getX() || pos.getX() > max.getX()) continue; //[I-S]LN=1036;[I-E]
         if (pos.getY() < min.getY() || pos.getY() > max.getY()) continue; //[I-S]LN=1037;[I-E]
         if (pos.getZ() < min.getZ() || pos.getZ() > max.getZ()) continue; //[I-S]LN=1038;[I-E]
    //[I-S]LN=1039;[I-E]
         float dx = Math.min(pos.getX() - min.getX(), max.getX() - pos.getX()); //[I-S]LN=1040;[I-E]
         float dy = Math.min(pos.getY() - min.getY(), max.getY() - pos.getY()); //[I-S]LN=1041;[I-E]
         float dz = Math.min(pos.getZ() - min.getZ(), max.getZ() - pos.getZ()); //[I-S]LN=1042;[I-E]
    //[I-S]LN=1043;[I-E]
         Vector3 corr; //[I-S]LN=1044;[I-E]
    //[I-S]LN=1045;[I-E]
         if (dx <= dy && dx <= dz) { //[I-S]LN=1046;[I-E]
           corr = new Vector3(pos.getX() - min.getX() < max.getX() - pos.getX() ? -dx : dx, 0, 0); //[I-S]LN=1047;[I-E]
         } else if (dy <= dz) { //[I-S]LN=1048;[I-E]
           corr = new Vector3(0, pos.getY() - min.getY() < max.getY() - pos.getY() ? -dy : dy, 0); //[I-S]LN=1049;[I-E]
         } else { //[I-S]LN=1050;[I-E]
           corr = new Vector3(0, 0, pos.getZ() - min.getZ() < max.getZ() - pos.getZ() ? -dz : dz); //[I-S]LN=1051;[I-E]
         } //[I-S]LN=1052;[I-E]
    //[I-S]LN=1053;[I-E]
         p.position = p.position.sum(corr); //[I-S]LN=1054;[I-E]
    //[I-S]LN=1055;[I-E]
         // damping de impacto //[I-S]LN=1056;[I-E]
         Vector3 vel = p.position.sub(p.previousPosition).mul(0.5f); //[I-S]LN=1057;[I-E]
         p.previousPosition = p.position.sub(vel); //[I-S]LN=1058;[I-E]
       } //[I-S]LN=1059;[I-E]
     } //[I-S]LN=1060;[I-E]
   } //[I-S]LN=1061;[I-E]
    //[I-S]LN=1062;[I-E]
   private void collideSpheres() { //[I-S]LN=1063;[I-E]
    //[I-S]LN=1064;[I-E]
     for (SpatialObject sph : sphereColliders) { //[I-S]LN=1065;[I-E]
    //[I-S]LN=1066;[I-E]
       Vector3 center = sph.getTransform().getGlobalPosition(); //[I-S]LN=1067;[I-E]
       float radius = sph.getTransform().getGlobalScale().getX() * 0.55f; //[I-S]LN=1068;[I-E]
    //[I-S]LN=1069;[I-E]
       for (clothPoint p : points) { //[I-S]LN=1070;[I-E]
    //[I-S]LN=1071;[I-E]
         if (p.isFixed) continue; //[I-S]LN=1072;[I-E]
    //[I-S]LN=1073;[I-E]
         Vector3 d = p.position.sub(center); //[I-S]LN=1074;[I-E]
         float dist = d.length(); //[I-S]LN=1075;[I-E]
    //[I-S]LN=1076;[I-E]
         if (dist >= radius || dist == 0f) continue; //[I-S]LN=1077;[I-E]
    //[I-S]LN=1078;[I-E]
         Vector3 corr = d.normalize().mul(radius - dist); //[I-S]LN=1079;[I-E]
         p.position = p.position.sum(corr); //[I-S]LN=1080;[I-E]
    //[I-S]LN=1081;[I-E]
         Vector3 vel = p.position.sub(p.previousPosition).mul(0.6f); //[I-S]LN=1082;[I-E]
         p.previousPosition = p.position.sub(vel); //[I-S]LN=1083;[I-E]
       } //[I-S]LN=1084;[I-E]
     } //[I-S]LN=1085;[I-E]
   } //[I-S]LN=1086;[I-E]
    //[I-S]LN=1087;[I-E]
   private void enablePhysicsProxies() { //[I-S]LN=1088;[I-E]
     if (!collideMeshes) return; // só ativa no modo rigidbody //[I-S]LN=1089;[I-E]
    //[I-S]LN=1090;[I-E]
     float radius = RB_pointRadius; //[I-S]LN=1091;[I-E]
     if (points != null) { //[I-S]LN=1092;[I-E]
       for (int i = 0; i < points.length; i++) { //[I-S]LN=1093;[I-E]
         clothPoint p = points[i]; //[I-S]LN=1094;[I-E]
         if (p == null) continue; //[I-S]LN=1095;[I-E]
    //[I-S]LN=1096;[I-E]
         SpatialObject pobj = myObject.findChildObject("ponto-" + i); //[I-S]LN=1097;[I-E]
         if (pobj == null) continue; //[I-S]LN=1098;[I-E]
    //[I-S]LN=1099;[I-E]
         // ajusta escala do objeto para o raio do ponto //[I-S]LN=1100;[I-E]
         pobj.setScale(radius, radius, radius); //[I-S]LN=1101;[I-E]
         pobj.getTransform().setIgnoreParent(true); //[I-S]LN=1102;[I-E]
         // cria collider se não existir //[I-S]LN=1103;[I-E]
         Collider sc = pobj.findComponent(Collider.class); //[I-S]LN=1104;[I-E]
         if (sc == null) { //[I-S]LN=1105;[I-E]
           sc = new Collider(); //[I-S]LN=1106;[I-E]
           sc.setShape(sc.getShape().valueOf("Sphere")); //[I-S]LN=1107;[I-E]
           pobj.addComponent(sc); //[I-S]LN=1108;[I-E]
         } //[I-S]LN=1109;[I-E]
    //[I-S]LN=1110;[I-E]
         // cria rigidbody se não existir //[I-S]LN=1111;[I-E]
         Rigidbody rb = pobj.findComponent(Rigidbody.class); //[I-S]LN=1112;[I-E]
         if (rb == null) { //[I-S]LN=1113;[I-E]
           rb = new Rigidbody(); //[I-S]LN=1114;[I-E]
           rb.setMass(mass); //[I-S]LN=1115;[I-E]
           rb.setGravityEnabled(false); //[I-S]LN=1116;[I-E]
    //[I-S]LN=1117;[I-E]
           // trava rotação //[I-S]LN=1118;[I-E]
           rb.setFreezeRX(true); //[I-S]LN=1119;[I-E]
           rb.setFreezeRY(true); //[I-S]LN=1120;[I-E]
           rb.setFreezeRZ(true); //[I-S]LN=1121;[I-E]
    //[I-S]LN=1122;[I-E]
           // damping e fricção //[I-S]LN=1123;[I-E]
           rb.setLinearDamping(0.1f); //[I-S]LN=1124;[I-E]
           rb.setAngularDamping(0.2f); //[I-S]LN=1125;[I-E]
           rb.setFriction(RB_friction); //[I-S]LN=1126;[I-E]
    //[I-S]LN=1127;[I-E]
           pobj.addComponent(rb); //[I-S]LN=1128;[I-E]
         } //[I-S]LN=1129;[I-E]
       } //[I-S]LN=1130;[I-E]
     } //[I-S]LN=1131;[I-E]
   } //[I-S]LN=1132;[I-E]
}