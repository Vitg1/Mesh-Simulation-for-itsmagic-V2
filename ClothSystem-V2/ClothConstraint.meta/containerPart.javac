public class _JContainer{}

//C-R:ClothConstraint
class ClothConstraint extends Component {
   public enum Type { //[I-S]LN=0;[I-E]
     STRUCTURAL, //[I-S]LN=1;[I-E]
     SHEAR, //[I-S]LN=2;[I-E]
     BENDING, //[I-S]LN=3;[I-E]
     BENDING_ADVANCED //[I-S]LN=4;[I-E]
   } //[I-S]LN=5;[I-E]
    //[I-S]LN=6;[I-E]
   public clothPoint p1; //[I-S]LN=7;[I-E]
   public clothPoint p2; //[I-S]LN=8;[I-E]
   public clothPoint p3; // Novo: Ponta do triângulo 1 //[I-S]LN=9;[I-E]
   public clothPoint p4; // Novo: Ponta do triângulo 2 //[I-S]LN=10;[I-E]
    //[I-S]LN=11;[I-E]
   public float restAngle; // Novo: Cosseno de repouso para metal/cloth advanced //[I-S]LN=12;[I-E]
   public float restLength; //[I-S]LN=13;[I-E]
   public float stiffness; //[I-S]LN=14;[I-E]
   public Type type; //[I-S]LN=15;[I-E]
   public float lambdaAccum = 0f; //[I-S]LN=16;[I-E]
   float compliance; //[I-S]LN=17;[I-E]
   float currentLength; //[I-S]LN=18;[I-E]
   Vector3 delta = new Vector3(); //[I-S]LN=19;[I-E]
   boolean hasRb; //[I-S]LN=20;[I-E]
   // ======================= //[I-S]LN=21;[I-E]
   // MATERIAL / PLASTICIDADE //[I-S]LN=22;[I-E]
   // ======================= //[I-S]LN=23;[I-E]
    //[I-S]LN=24;[I-E]
   private float hardeningAccum = 0f; //[I-S]LN=25;[I-E]
   float plasticStrain = 0.0f; //[I-S]LN=26;[I-E]
   // Referência //[I-S]LN=27;[I-E]
   private float originalRestLength; //[I-S]LN=28;[I-E]
    //[I-S]LN=29;[I-E]
   float sign(float v) { //[I-S]LN=30;[I-E]
     return v > 0 ? 1f : (v < 0 ? -1f : 0f); //[I-S]LN=31;[I-E]
   } //[I-S]LN=32;[I-E]
    //[I-S]LN=33;[I-E]
   public void start() { //[I-S]LN=34;[I-E]
     if (type == Type.BENDING_ADVANCED) { //[I-S]LN=35;[I-E]
       // Agora salva o ângulo real em radianos //[I-S]LN=36;[I-E]
       restAngle = calculateCurrentAngleRad(); //[I-S]LN=37;[I-E]
     } else { //[I-S]LN=38;[I-E]
       restLength = p1.position.distance(p2.position); //[I-S]LN=39;[I-E]
       originalRestLength = restLength; //[I-S]LN=40;[I-E]
     } //[I-S]LN=41;[I-E]
   } //[I-S]LN=42;[I-E]
    //[I-S]LN=43;[I-E]
   private float calculateCurrentAngleRad() { //[I-S]LN=44;[I-E]
     Vector3 e = p2.position.sub(p1.position); //[I-S]LN=45;[I-E]
     float elen = e.length(); //[I-S]LN=46;[I-E]
     if (elen < 1e-7f) return 0f; //[I-S]LN=47;[I-E]
    //[I-S]LN=48;[I-E]
     // Normais //[I-S]LN=49;[I-E]
     Vector3 n1 = e.cross(p3.position.sub(p1.position)).normalize(); //[I-S]LN=50;[I-E]
     Vector3 n2 = e.cross(p4.position.sub(p1.position)).normalize(); //[I-S]LN=51;[I-E]
    //[I-S]LN=52;[I-E]
     float dot = n1.dot(n2); //[I-S]LN=53;[I-E]
     // Clamp para evitar NaN no acos //[I-S]LN=54;[I-E]
     dot = Math.max(-1f, Math.min(1f, dot)); //[I-S]LN=55;[I-E]
      //[I-S]LN=56;[I-E]
     return (float) Math.acos(dot); // Retorna radianos (0 a 3.1415...) //[I-S]LN=57;[I-E]
   } //[I-S]LN=58;[I-E]
    //[I-S]LN=59;[I-E]
   void PBD() { // Lógica PBD (sem RB) - Mantida //[I-S]LN=60;[I-E]
     float diff = (currentLength - restLength) / currentLength; //[I-S]LN=61;[I-E]
     float adjustment = stiffness; //[I-S]LN=62;[I-E]
     if (type == Type.SHEAR) adjustment *= 0.6f; //[I-S]LN=63;[I-E]
     else if (type == Type.BENDING) adjustment *= 0.2f; //[I-S]LN=64;[I-E]
     Vector3 correction = delta.mul(adjustment * diff); //[I-S]LN=65;[I-E]
     if (!p1.isFixed && !p1.anchored) p1.position = p1.position.sum(correction.mul(0.5f)); //[I-S]LN=66;[I-E]
     if (!p2.isFixed && !p2.anchored) p2.position = p2.position.sub(correction.mul(0.5f)); //[I-S]LN=67;[I-E]
   } //[I-S]LN=68;[I-E]
   void XPBD_Bending_Advanced(float complianceInput, float betaf, float slopf, float dampingCoefficientf, float yieldStrainf, float plasticRatef, float maxPlasticStrainf, float hardeningf, float subDtf) { //[I-S]LN=69;[I-E]
       if (subDtf <= 1e-6f) return; //[I-S]LN=70;[I-E]
    //[I-S]LN=71;[I-E]
       final float EPS = 1e-7f; //[I-S]LN=72;[I-E]
    //[I-S]LN=73;[I-E]
       // --- 1) Geometria (Igual antes) --- //[I-S]LN=74;[I-E]
       Vector3 p1Pos = p1.position; Vector3 p2Pos = p2.position; //[I-S]LN=75;[I-E]
       Vector3 p3Pos = p3.position; Vector3 p4Pos = p4.position; //[I-S]LN=76;[I-E]
    //[I-S]LN=77;[I-E]
       Vector3 e = p2Pos.sub(p1Pos); //[I-S]LN=78;[I-E]
       float elen = e.length(); //[I-S]LN=79;[I-E]
       if (elen < EPS) return; //[I-S]LN=80;[I-E]
       Vector3 eDir = e.mul(1f / elen); //[I-S]LN=81;[I-E]
    //[I-S]LN=82;[I-E]
       Vector3 n1 = e.cross(p3Pos.sub(p1Pos)); //[I-S]LN=83;[I-E]
       Vector3 n2 = e.cross(p4Pos.sub(p1Pos)); //[I-S]LN=84;[I-E]
       float n1Len = n1.length(); //[I-S]LN=85;[I-E]
       float n2Len = n2.length(); //[I-S]LN=86;[I-E]
       if (n1Len < EPS || n2Len < EPS) return; //[I-S]LN=87;[I-E]
    //[I-S]LN=88;[I-E]
       Vector3 n1n = n1.mul(1f / n1Len); //[I-S]LN=89;[I-E]
       Vector3 n2n = n2.mul(1f / n2Len); //[I-S]LN=90;[I-E]
    //[I-S]LN=91;[I-E]
       float dot = n1n.dot(n2n); //[I-S]LN=92;[I-E]
       dot = Math.max(-1f, Math.min(1f, dot)); //[I-S]LN=93;[I-E]
       float currentAngle = (float)Math.acos(dot); //[I-S]LN=94;[I-E]
    //[I-S]LN=95;[I-E]
       // --- 2) Constraint e SLOP (Novidade 1) --- //[I-S]LN=96;[I-E]
       // Slop: Se o erro for muito pequeno, nem calcula. Economiza CPU e evita tremedeira. //[I-S]LN=97;[I-E]
       float C = currentAngle - restAngle; //[I-S]LN=98;[I-E]
       if (Math.abs(C) < slopf) return;  //[I-S]LN=99;[I-E]
    //[I-S]LN=100;[I-E]
       // --- 3) Plasticidade com Hardening e MaxStrain (Novidade 2 e 3) --- //[I-S]LN=101;[I-E]
       // Hardening: Aumenta o limite de elasticidade (yield) baseado no quanto já deformou. //[I-S]LN=102;[I-E]
       // Assumindo que 'restAngle' começou perto de 0, o abs(restAngle) é o quanto já deformou. //[I-S]LN=103;[I-E]
       float currentHardening = hardeningf * Math.abs(restAngle);  //[I-S]LN=104;[I-E]
       float effectiveYield = yieldStrainf + currentHardening; //[I-S]LN=105;[I-E]
    //[I-S]LN=106;[I-E]
       if (plasticRatef > 0f && Math.abs(C) > effectiveYield) { //[I-S]LN=107;[I-E]
           float sign = (C >= 0f) ? 1f : -1f; //[I-S]LN=108;[I-E]
           // Taxa de deformação plástica //[I-S]LN=109;[I-E]
           float deltaPlastic = sign * plasticRatef * (Math.abs(C) - effectiveYield) * subDtf; //[I-S]LN=110;[I-E]
            //[I-S]LN=111;[I-E]
           restAngle += deltaPlastic; //[I-S]LN=112;[I-E]
    //[I-S]LN=113;[I-E]
           // Max Plastic Strain: Limita o quanto o metal pode entortar no total //[I-S]LN=114;[I-E]
           // (Aqui assumo limites hardcoded de PI, mas o maxPlasticStrainf deve ser menor, ex: 45 graus) //[I-S]LN=115;[I-E]
           float limit = maxPlasticStrainf > 0 ? maxPlasticStrainf : (float)Math.PI; //[I-S]LN=116;[I-E]
           restAngle = Math.max(-limit, Math.min(limit, restAngle)); //[I-S]LN=117;[I-E]
            //[I-S]LN=118;[I-E]
           // Recalcula C com o novo restAngle para a força elástica atuar apenas no que sobrou //[I-S]LN=119;[I-E]
           C = currentAngle - restAngle; //[I-S]LN=120;[I-E]
       } //[I-S]LN=121;[I-E]
        //[I-S]LN=122;[I-E]
       // Check de saída antecipada se a plasticidade resolveu tudo //[I-S]LN=123;[I-E]
       if (Math.abs(C) < 1e-9f) return; //[I-S]LN=124;[I-E]
    //[I-S]LN=125;[I-E]
       // --- 4) Gradientes Corrigidos pela Geometria --- //[I-S]LN=126;[I-E]
       float invH1 = elen / n1Len; //[I-S]LN=127;[I-E]
       float invH2 = elen / n2Len; //[I-S]LN=128;[I-E]
       Vector3 g3 = eDir.cross(n1n).mul(invH1); //[I-S]LN=129;[I-E]
       Vector3 g4 = n2n.cross(eDir).mul(invH2); //[I-S]LN=130;[I-E]
       Vector3 gSum = g3.sum(g4); //[I-S]LN=131;[I-E]
       Vector3 g1 = gSum.mul(-0.5f); //[I-S]LN=132;[I-E]
       Vector3 g2 = gSum.mul(-0.5f); //[I-S]LN=133;[I-E]
    //[I-S]LN=134;[I-E]
       // --- 5) Pesos --- //[I-S]LN=135;[I-E]
       float w1 = (p1.isFixed || p1.anchored) ? 0f : (1f/p1.rb.getMass()); //[I-S]LN=136;[I-E]
       float w2 = (p2.isFixed || p2.anchored) ? 0f : (1f/p2.rb.getMass()); //[I-S]LN=137;[I-E]
       float w3 = (p3.isFixed || p3.anchored) ? 0f : (1f/p3.rb.getMass()); //[I-S]LN=138;[I-E]
       float w4 = (p4.isFixed || p4.anchored) ? 0f : (1f/p4.rb.getMass()); //[I-S]LN=139;[I-E]
    //[I-S]LN=140;[I-E]
       float sum = w1 * g1.dot(g1) + w2 * g2.dot(g2) + w3 * g3.dot(g3) + w4 * g4.dot(g4); //[I-S]LN=141;[I-E]
       if (sum < EPS) return; //[I-S]LN=142;[I-E]
    //[I-S]LN=143;[I-E]
       // --- 6) Compliance e Damping Avançado (Novidade 4) --- //[I-S]LN=144;[I-E]
       // alpha = compliance / dt^2 //[I-S]LN=145;[I-E]
       float alpha = complianceInput / (subDtf * subDtf); //[I-S]LN=146;[I-E]
        //[I-S]LN=147;[I-E]
       // Damping XPBD: Adiciona viscosidade ao denominador. //[I-S]LN=148;[I-E]
       // Existem várias fórmulas, mas esta é a "Rayleigh Damping" aproximada pra XPBD. //[I-S]LN=149;[I-E]
       // Ela "suja" o denominador fazendo o sistema resistir a mudanças rápidas. //[I-S]LN=150;[I-E]
       float dampingTerm = dampingCoefficientf * subDtf;  //[I-S]LN=151;[I-E]
        //[I-S]LN=152;[I-E]
       // Se 'betaf' for para integração Newmark ou similar, pode ignorar,  //[I-S]LN=153;[I-E]
       // mas se for um fator extra de rigidez viscosa, some ele aqui também. //[I-S]LN=154;[I-E]
       // Vou assumir que betaf é um multiplicador extra ou bias. //[I-S]LN=155;[I-E]
        //[I-S]LN=156;[I-E]
       float denom = sum + alpha + dampingTerm;  //[I-S]LN=157;[I-E]
        //[I-S]LN=158;[I-E]
       // --- 7) Lambda e Correção --- //[I-S]LN=159;[I-E]
       float deltaLambda = -C / denom; //[I-S]LN=160;[I-E]
    //[I-S]LN=161;[I-E]
       Vector3 dx1 = g1.mul(w1 * deltaLambda); //[I-S]LN=162;[I-E]
       Vector3 dx2 = g2.mul(w2 * deltaLambda); //[I-S]LN=163;[I-E]
       Vector3 dx3 = g3.mul(w3 * deltaLambda); //[I-S]LN=164;[I-E]
       Vector3 dx4 = g4.mul(w4 * deltaLambda); //[I-S]LN=165;[I-E]
    //[I-S]LN=166;[I-E]
       if (w1 > 0f) p1.rb.addVelocity(dx1.mul(1f / subDtf)); //[I-S]LN=167;[I-E]
       if (w2 > 0f) p2.rb.addVelocity(dx2.mul(1f / subDtf)); //[I-S]LN=168;[I-E]
       if (w3 > 0f) p3.rb.addVelocity(dx3.mul(1f / subDtf)); //[I-S]LN=169;[I-E]
       if (w4 > 0f) p4.rb.addVelocity(dx4.mul(1f / subDtf)); //[I-S]LN=170;[I-E]
   } //[I-S]LN=171;[I-E]
      //[I-S]LN=172;[I-E]
   void XPBD_Metal(float ComplianceInput, float Beta, float slop, float dampingCoefficient,float InternalFriction, float yieldStrain,  //[I-S]LN=173;[I-E]
   float plasticRate, float maxPlasticStrain, float hardening, float subDt) {   //[I-S]LN=174;[I-E]
     float dt = subDt;   //[I-S]LN=175;[I-E]
     if (dt <= 1e-6f) return;   //[I-S]LN=176;[I-E]
      //[I-S]LN=177;[I-E]
     // ----------------------------   //[I-S]LN=178;[I-E]
     // 1) Compliance / estabilidade   //[I-S]LN=179;[I-E]
     // ----------------------------   //[I-S]LN=180;[I-E]
     float slider = ComplianceInput;   //[I-S]LN=181;[I-E]
     // evita pow(10, -inf) com slider muito pequeno   //[I-S]LN=182;[I-E]
     final float alphaMin = 1e-9f;   //[I-S]LN=183;[I-E]
     float compliance = (slider <= 0.001f) ? 0f : (float) Math.pow(10f, slider - 10f);   //[I-S]LN=184;[I-E]
     if (type == Type.SHEAR) compliance *= 2.0f;   //[I-S]LN=185;[I-E]
     if (type == Type.BENDING) compliance *= 0.5f;   //[I-S]LN=186;[I-E]
      //[I-S]LN=187;[I-E]
     // XPBD usual: alpha = compliance / (dt*dt)   //[I-S]LN=188;[I-E]
     float alpha = (compliance <= 0f) ? alphaMin : Math.max(alphaMin, compliance / (dt * dt));   //[I-S]LN=189;[I-E]
   float gamma = Math.min(alpha / dt, 1f);// termo de estabilização (usado na atualização de lambda)   //[I-S]LN=190;[I-E]
      //[I-S]LN=191;[I-E]
     // ----------------------------   //[I-S]LN=192;[I-E]
     // 2) geometric quantities   //[I-S]LN=193;[I-E]
     // ----------------------------   //[I-S]LN=194;[I-E]
     float currentLen = currentLength;   //[I-S]LN=195;[I-E]
     if (currentLen <= 1e-8f) return;   //[I-S]LN=196;[I-E]
     Vector3 dir = delta.mul(1f / currentLen);   //[I-S]LN=197;[I-E]
      //[I-S]LN=198;[I-E]
     // ----------------------------   //[I-S]LN=199;[I-E]
     // 3) plasticidade (metal)   //[I-S]LN=200;[I-E]
     // ----------------------------   //[I-S]LN=201;[I-E]
     // Variáveis de instância esperadas: float plasticStrain; // estado acumulado   //[I-S]LN=202;[I-E]
     //                              float originalRestLength; // comprimento inicial de referência   //[I-S]LN=203;[I-E]
     //                              float hardeningAccum; // se quiser acumular algo extra   //[I-S]LN=204;[I-E]
     if (plasticRate > 0f) {   //[I-S]LN=205;[I-E]
       // strain atual em relação ao restLength atual   //[I-S]LN=206;[I-E]
       float curRest = restLength; // restLength agora representa comprimento elástico atual   //[I-S]LN=207;[I-E]
       float strain = (currentLen - curRest) / curRest; // positivo = tração, negativo = compressão   //[I-S]LN=208;[I-E]
       float absStrain = Math.abs(strain);   //[I-S]LN=209;[I-E]
      //[I-S]LN=210;[I-E]
       // yield efetivo com hardening dependente da plasticStrain   //[I-S]LN=211;[I-E]
       float yieldEff = yieldStrain + hardening * plasticStrain;   //[I-S]LN=212;[I-E]
      //[I-S]LN=213;[I-E]
       // torna bending mais resistente   //[I-S]LN=214;[I-E]
       if (type == Type.BENDING) yieldEff *= 3.0f;   //[I-S]LN=215;[I-E]
      //[I-S]LN=216;[I-E]
       // compressão pode aumentar resistência   //[I-S]LN=217;[I-E]
       if (currentLen < curRest) yieldEff *= 1.5f;   //[I-S]LN=218;[I-E]
      //[I-S]LN=219;[I-E]
       // se passou do yield, incrementa plasticStrain de forma rate-limited (viscoplastic)   //[I-S]LN=220;[I-E]
       if (absStrain > yieldEff) {   //[I-S]LN=221;[I-E]
         float excess = absStrain - yieldEff;   //[I-S]LN=222;[I-E]
         // usa uma rampa para não aplicar tudo de uma vez   //[I-S]LN=223;[I-E]
         float deltaPlastic = sign(strain) * plasticRate * excess * dt;   //[I-S]LN=224;[I-E]
         // limita o incremento para não explodir   //[I-S]LN=225;[I-E]
         float newPlastic = plasticStrain + deltaPlastic;   //[I-S]LN=226;[I-E]
         newPlastic = Math.max(-maxPlasticStrain, Math.min(maxPlasticStrain, newPlastic));   //[I-S]LN=227;[I-E]
         float applied = newPlastic - plasticStrain;   //[I-S]LN=228;[I-E]
         plasticStrain = newPlastic;   //[I-S]LN=229;[I-E]
      //[I-S]LN=230;[I-E]
         // atualiza restLength suavemente a partir do original   //[I-S]LN=231;[I-E]
         restLength = originalRestLength * (1f + plasticStrain);   //[I-S]LN=232;[I-E]
      //[I-S]LN=233;[I-E]
         // acumula dureza (opcional)   //[I-S]LN=234;[I-E]
         hardeningAccum += Math.abs(applied) * hardening;   //[I-S]LN=235;[I-E]
       } else {   //[I-S]LN=236;[I-E]
         // quando abaixo do yield, não zera alpha — apenas reduz comportamento plástico   //[I-S]LN=237;[I-E]
         // mantém alpha pequeno (já garantido acima)   //[I-S]LN=238;[I-E]
       }   //[I-S]LN=239;[I-E]
     }   //[I-S]LN=240;[I-E]
      //[I-S]LN=241;[I-E]
     // ----------------------------   //[I-S]LN=242;[I-E]
     // 4) limitar deformações extremas (hard-limit)   //[I-S]LN=243;[I-E]
     // ----------------------------   //[I-S]LN=244;[I-E]
     float maxStretch = originalRestLength * 0.02f; // 2% sobre original   //[I-S]LN=245;[I-E]
     float maxCompress = -originalRestLength * 0.05f; // -5% sobre original   //[I-S]LN=246;[I-E]
     float error = currentLen - restLength;   //[I-S]LN=247;[I-E]
     error = Math.max(maxCompress, Math.min(error, maxStretch));   //[I-S]LN=248;[I-E]
     float clampedLen = restLength + error; //[I-S]LN=249;[I-E]
   if (clampedLen <= 1e-8f) return; //[I-S]LN=250;[I-E]
     // recomputa C a partir do erro limitado   //[I-S]LN=251;[I-E]
     // (vamos usar essa C mais adiante)   //[I-S]LN=252;[I-E]
     // obs: mantemos restLength como possivel valor plastificado   //[I-S]LN=253;[I-E]
     // nota: mantivemos currentLen acima para calcular dir   //[I-S]LN=254;[I-E]
     // substituímos C abaixo   //[I-S]LN=255;[I-E]
      //[I-S]LN=256;[I-E]
     // ----------------------------   //[I-S]LN=257;[I-E]
     // 5) massas / weights (usar inverse mass)   //[I-S]LN=258;[I-E]
     // ----------------------------   //[I-S]LN=259;[I-E]
     final float massScale = 0.1f;   //[I-S]LN=260;[I-E]
     float invM1 = (p1.isFixed || p1.anchored) ? 0f : (1f / Math.max(1e-8f, p1.rb.getMass()));   //[I-S]LN=261;[I-E]
     float invM2 = (p2.isFixed || p2.anchored) ? 0f : (1f / Math.max(1e-8f, p2.rb.getMass()));   //[I-S]LN=262;[I-E]
     float w1 = invM1 * massScale;   //[I-S]LN=263;[I-E]
     float w2 = invM2 * massScale;   //[I-S]LN=264;[I-E]
     w1 *= 0.05f;   //[I-S]LN=265;[I-E]
     w2 *= 0.05f;   //[I-S]LN=266;[I-E]
      //[I-S]LN=267;[I-E]
     float wTotal = w1 + w2;   //[I-S]LN=268;[I-E]
     if (wTotal <= 0f) return;   //[I-S]LN=269;[I-E]
      //[I-S]LN=270;[I-E]
      //[I-S]LN=271;[I-E]
      //[I-S]LN=272;[I-E]
      //[I-S]LN=273;[I-E]
      //[I-S]LN=274;[I-E]
     // ----------------------------   //[I-S]LN=275;[I-E]
     // 6) constraint & bias   //[I-S]LN=276;[I-E]
     // ----------------------------   //[I-S]LN=277;[I-E]
     float C = error;   //[I-S]LN=278;[I-E]
      //[I-S]LN=279;[I-E]
     C *= (C > 0f) ? 2.5f : 1.5f;   //[I-S]LN=280;[I-E]
      //[I-S]LN=281;[I-E]
     // slop: deixa uma faixa pequena sem corrigir   //[I-S]LN=282;[I-E]
     if (Math.abs(C) <= slop) return;   //[I-S]LN=283;[I-E]
      //[I-S]LN=284;[I-E]
     float beta = Math.min(Beta, 0.1f);   //[I-S]LN=285;[I-E]
     float vRel = p2.rb.getVelocity().sub(p1.rb.getVelocity()).dot(dir);   //[I-S]LN=286;[I-E]
     float internalFriction = InternalFriction;   //[I-S]LN=287;[I-E]
      //[I-S]LN=288;[I-E]
     // bias term clássico XPBD (positional damping converted to velocity-space here)   //[I-S]LN=289;[I-E]
     float biasTerm = (beta / dt) * C * internalFriction;   //[I-S]LN=290;[I-E]
      //[I-S]LN=291;[I-E]
     // ----------------------------   //[I-S]LN=292;[I-E]
     // 7) lambda solve (estabilizado)   //[I-S]LN=293;[I-E]
     // ----------------------------   //[I-S]LN=294;[I-E]
     // evita divisão por zero com gamma garantido acima   //[I-S]LN=295;[I-E]
     float numerator = -(vRel + biasTerm + gamma * lambdaAccum);   //[I-S]LN=296;[I-E]
     float denominator = wTotal + gamma;   //[I-S]LN=297;[I-E]
     float deltaLambda = numerator / denominator;   //[I-S]LN=298;[I-E]
      //[I-S]LN=299;[I-E]
     // limita lambda acumulado para evitar drift extremo   //[I-S]LN=300;[I-E]
     float lambdaLimit = 10f / Math.max(1e-6f, wTotal); //[I-S]LN=301;[I-E]
     lambdaAccum = Math.max(-lambdaLimit, Math.min(lambdaLimit, lambdaAccum + deltaLambda));   //[I-S]LN=302;[I-E]
      //[I-S]LN=303;[I-E]
     Vector3 impulse = dir.mul(deltaLambda);   //[I-S]LN=304;[I-E]
     if (w1 > 0f) p1.rb.addVelocity(impulse.mul(-w1));   //[I-S]LN=305;[I-E]
     if (w2 > 0f) p2.rb.addVelocity(impulse.mul(w2));   //[I-S]LN=306;[I-E]
      //[I-S]LN=307;[I-E]
     // ----------------------------   //[I-S]LN=308;[I-E]
     // 8) damping direcional (viscous)   //[I-S]LN=309;[I-E]
     // ----------------------------   //[I-S]LN=310;[I-E]
     Vector3 newVRelVec = p2.rb.getVelocity().sub(p1.rb.getVelocity());   //[I-S]LN=311;[I-E]
     float newVRel = newVRelVec.dot(dir);   //[I-S]LN=312;[I-E]
     float finalDamping = (internalFriction > 1.0f) ? 25.0f : dampingCoefficient;   //[I-S]LN=313;[I-E]
     if (finalDamping > 0.001f) {   //[I-S]LN=314;[I-E]
       float dampImpulse = -newVRel * (1.0f - (float) Math.exp(-finalDamping * dt));   //[I-S]LN=315;[I-E]
       Vector3 dImp = dir.mul(dampImpulse / wTotal);   //[I-S]LN=316;[I-E]
       if (w1 > 0f) p1.rb.addVelocity(dImp.mul(-w1));   //[I-S]LN=317;[I-E]
       if (w2 > 0f) p2.rb.addVelocity(dImp.mul(w2));   //[I-S]LN=318;[I-E]
     }   //[I-S]LN=319;[I-E]
   }   //[I-S]LN=320;[I-E]
    //[I-S]LN=321;[I-E]
    //[I-S]LN=322;[I-E]
    //[I-S]LN=323;[I-E]
    //[I-S]LN=324;[I-E]
   void XPBD_Cloth(float ComplianceInput, float Beta, float slop, float dampingCoefficient, float InternalFriction,float subDt) { //[I-S]LN=325;[I-E]
       float dt = subDt;  //[I-S]LN=326;[I-E]
       if (dt <= 1e-6f) return; //[I-S]LN=327;[I-E]
    //[I-S]LN=328;[I-E]
       // 1) Compliance (Slider 0-1) //[I-S]LN=329;[I-E]
       // Para tecidos que não esticam, queremos compliance quase 0 (10^-9) //[I-S]LN=330;[I-E]
       float compliance = (ComplianceInput <= 0.001f) ? 0f : (float) Math.pow(10f, ComplianceInput - 10f); //[I-S]LN=331;[I-E]
        //[I-S]LN=332;[I-E]
       // Shear e Structural precisam de "mordida", Bending pode ser mais mole //[I-S]LN=333;[I-E]
       if (type == Type.SHEAR) compliance *= 0.1f; // Força extra nas diagonais //[I-S]LN=334;[I-E]
        //[I-S]LN=335;[I-E]
       // alpha no XPBD de velocidade é compliance / dt^2 //[I-S]LN=336;[I-E]
       float alpha = compliance / (dt * dt); //[I-S]LN=337;[I-E]
    //[I-S]LN=338;[I-E]
       // 2) Geometria //[I-S]LN=339;[I-E]
       Vector3 diff = p2.position.sub(p1.position); //[I-S]LN=340;[I-E]
       float currentLen = diff.length(); //[I-S]LN=341;[I-E]
       if (currentLen <= 1e-8f) return; //[I-S]LN=342;[I-E]
       Vector3 dir = diff.mul(1f / currentLen); //[I-S]LN=343;[I-E]
    //[I-S]LN=344;[I-E]
       // 3) Massas Inversas //[I-S]LN=345;[I-E]
       float w1 = (p1.isFixed || p1.anchored) ? 0f : (1f / Math.max(1e-8f, p1.rb.getMass())); //[I-S]LN=346;[I-E]
       float w2 = (p2.isFixed || p2.anchored) ? 0f : (1f / Math.max(1e-8f, p2.rb.getMass())); //[I-S]LN=347;[I-E]
       float wTotal = w1 + w2; //[I-S]LN=348;[I-E]
       if (wTotal <= 0f) return; //[I-S]LN=349;[I-E]
    //[I-S]LN=350;[I-E]
       // 4) O SEGREDO: Bias de Velocidade (Sua força de colisão) //[I-S]LN=351;[I-E]
       float C = currentLen - restLength; //[I-S]LN=352;[I-E]
       if (Math.abs(C) <= slop) C = 0; //[I-S]LN=353;[I-E]
        //[I-S]LN=354;[I-E]
       // Beta entre 0.1 e 0.5 para estabilidade, ou 1.0 para rigidez absoluta //[I-S]LN=355;[I-E]
       float bias = (Beta / dt) * C; //[I-S]LN=356;[I-E]
    //[I-S]LN=357;[I-E]
       // 5) Velocidade Relativa //[I-S]LN=358;[I-E]
       float vRel = p2.rb.getVelocity().sub(p1.rb.getVelocity()).dot(dir); //[I-S]LN=359;[I-E]
    //[I-S]LN=360;[I-E]
       // 6) Solver XPBD Estabilizado //[I-S]LN=361;[I-E]
       // Adicionamos (alpha * dt) no denominador para evitar a tremedeira em pontos fixos //[I-S]LN=362;[I-E]
       float numerator = -(vRel + bias + alpha * lambdaAccum * dt); //[I-S]LN=363;[I-E]
       float denominator = wTotal + alpha * dt; //[I-S]LN=364;[I-E]
        //[I-S]LN=365;[I-E]
       float deltaLambda = numerator / (denominator + 1e-9f); //[I-S]LN=366;[I-E]
       lambdaAccum += deltaLambda; //[I-S]LN=367;[I-E]
    //[I-S]LN=368;[I-E]
       // 7) Aplicação de Impulso (Sem mexer na position na mão!) //[I-S]LN=369;[I-E]
       // Deixamos o RB mover a posição através da velocidade, evitando teleporte. //[I-S]LN=370;[I-E]
       Vector3 impulse = dir.mul(deltaLambda); //[I-S]LN=371;[I-E]
       if (w1 > 0f) p1.rb.addVelocity(impulse.mul(-w1)); //[I-S]LN=372;[I-E]
       if (w2 > 0f) p2.rb.addVelocity(impulse.mul(w2)); //[I-S]LN=373;[I-E]
    //[I-S]LN=374;[I-E]
    //[I-S]LN=375;[I-E]
    //[I-S]LN=376;[I-E]
      float friction = InternalFriction; //[I-S]LN=377;[I-E]
   if (friction > 1e-6f) { //[I-S]LN=378;[I-E]
    //[I-S]LN=379;[I-E]
       float dv = -vRel * Math.min(1.0f, friction * dt); //[I-S]LN=380;[I-E]
    //[I-S]LN=381;[I-E]
       float impulseMag = dv / (wTotal + 1e-9f); //[I-S]LN=382;[I-E]
       Vector3 fImpulse = dir.mul(impulseMag); //[I-S]LN=383;[I-E]
    //[I-S]LN=384;[I-E]
       if (w1 > 0f) p1.rb.addVelocity(fImpulse.mul(-w1)); //[I-S]LN=385;[I-E]
       if (w2 > 0f) p2.rb.addVelocity(fImpulse.mul(w2)); //[I-S]LN=386;[I-E]
   } //[I-S]LN=387;[I-E]
    //[I-S]LN=388;[I-E]
       // 8) Damping Direcional (Opcional - limpa vibrações de alta frequência) //[I-S]LN=389;[I-E]
       if (dampingCoefficient > 0.001f) { //[I-S]LN=390;[I-E]
           float vRelPost = p2.rb.getVelocity().sub(p1.rb.getVelocity()).dot(dir); //[I-S]LN=391;[I-E]
           float dImp = -vRelPost * Math.min(1.0f, dampingCoefficient * dt); //[I-S]LN=392;[I-E]
           Vector3 dampVec = dir.mul(dImp / wTotal); //[I-S]LN=393;[I-E]
           if (w1 > 0f) p1.rb.addVelocity(dampVec.mul(-w1)); //[I-S]LN=394;[I-E]
           if (w2 > 0f) p2.rb.addVelocity(dampVec.mul(w2)); //[I-S]LN=395;[I-E]
       } //[I-S]LN=396;[I-E]
        //[I-S]LN=397;[I-E]
    } //[I-S]LN=398;[I-E]
    //[I-S]LN=399;[I-E]
    //[I-S]LN=400;[I-E]
    //[I-S]LN=401;[I-E]
    //[I-S]LN=402;[I-E]
    //[I-S]LN=403;[I-E]
   public void satisfy(float complianceInput, float betaf, float slopf, float dampingCoefficientf,float Internalfrictionf, float yieldStrainf, float plasticRatef, //[I-S]LN=404;[I-E]
   float maxPlasticStrainf, float hardeningf, float Dt_fake,float Dt_real,boolean useTimeStep) { hasRb = (p1.rb != null && p2.rb != null); //[I-S]LN=405;[I-E]
    //[I-S]LN=406;[I-E]
   if (type == Type.BENDING_ADVANCED) { //[I-S]LN=407;[I-E]
   if (hasRb) { //[I-S]LN=408;[I-E]
   XPBD_Bending_Advanced(complianceInput, betaf,slopf, dampingCoefficientf,yieldStrainf, //[I-S]LN=409;[I-E]
   plasticRatef,maxPlasticStrainf,hardeningf,(useTimeStep)?Dt_fake:Dt_real); //[I-S]LN=410;[I-E]
   } //[I-S]LN=411;[I-E]
   return; //[I-S]LN=412;[I-E]
   } //[I-S]LN=413;[I-E]
   // --- ABAIXO MANTÉM SUA LÓGICA ORIGINAL DE 2 PONTOS --- //[I-S]LN=414;[I-E]
   delta = p2.position.sub(p1.position); //[I-S]LN=415;[I-E]
   currentLength = delta.length(); //[I-S]LN=416;[I-E]
   if (currentLength < 1e-6f) return; //[I-S]LN=417;[I-E]
    //[I-S]LN=418;[I-E]
   if (!hasRb) PBD(); //[I-S]LN=419;[I-E]
   else { //[I-S]LN=420;[I-E]
   if (yieldStrainf > 0.0001f) XPBD_Metal(complianceInput, betaf, slopf, dampingCoefficientf,Internalfrictionf, yieldStrainf, plasticRatef, maxPlasticStrainf, hardeningf,(useTimeStep)?Dt_fake:Dt_real); //[I-S]LN=421;[I-E]
   else XPBD_Cloth(complianceInput, betaf, slopf, dampingCoefficientf,Internalfrictionf,(useTimeStep)?Dt_fake:Dt_real); //[I-S]LN=422;[I-E]
   } //[I-S]LN=423;[I-E]
    //[I-S]LN=424;[I-E]
   } //[I-S]LN=425;[I-E]
}