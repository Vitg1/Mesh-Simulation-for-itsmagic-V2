package JAVARuntime;

import java.util.*;
import java.util.concurrent.*;
import java.util.concurrent.atomic.*;
import java.util.concurrent.locks.*;
import java.util.function.*;
import java.util.regex.*;
import java.util.stream.*;
import java.util.zip.*;
import java.text.*;
import java.net.*;
import java.math.*;
import java.io.*;
import java.nio.*;
import java.time.*;
import java.time.chrono.*;
import java.time.format.*;
import java.time.temporal.*;
import java.time.zone.*;



public class _JContainer{}

//C-R:clothPoint
class clothPoint extends Component {
   /* @Author Sr Mil Games */ //[I-S]LN=0;[I-E]
   @Hide public Vector3 position; //[I-S]LN=1;[I-E]
   @Hide public Vector3 localPosition; //[I-S]LN=2;[I-E]
   @Hide public Vector3 previousPosition; //[I-S]LN=3;[I-E]
    //[I-S]LN=4;[I-E]
   public boolean isFixed = false; //[I-S]LN=5;[I-E]
    //[I-S]LN=6;[I-E]
   @Hide boolean anchored; //[I-S]LN=7;[I-E]
    //[I-S]LN=8;[I-E]
   public int vertexIndex; //[I-S]LN=9;[I-E]
    //[I-S]LN=10;[I-E]
   public SpatialObject anchor; //[I-S]LN=11;[I-E]
    //[I-S]LN=12;[I-E]
   @Hide Vector3 accumulatedForce = new Vector3(); //[I-S]LN=13;[I-E]
    //[I-S]LN=14;[I-E]
   @AutoWired @Hide Rigidbody rb; //[I-S]LN=15;[I-E]
    //[I-S]LN=16;[I-E]
   private boolean justReleased; //[I-S]LN=17;[I-E]
   private boolean initialized; //[I-S]LN=18;[I-E]
    //[I-S]LN=19;[I-E]
   public void applyForce(Vector3 force) { //[I-S]LN=20;[I-E]
     accumulatedForce = accumulatedForce.sum(force); //[I-S]LN=21;[I-E]
   } //[I-S]LN=22;[I-E]
    //[I-S]LN=23;[I-E]
   // No clothPoint.simulate: //[I-S]LN=24;[I-E]
   public void simulate(float timeStep, float damping, float airdrag) { //[I-S]LN=25;[I-E]
     if (myObject != null && myObject.exists() && rb == null) myObject.setGlobalPosition(position); //[I-S]LN=26;[I-E]
    //[I-S]LN=27;[I-E]
     if (rb == null) { //[I-S]LN=28;[I-E]
       if (anchor != null && anchor.exists()) { //[I-S]LN=29;[I-E]
         anchored = true; //[I-S]LN=30;[I-E]
         // isFixed=true; //[I-S]LN=31;[I-E]
         position = anchor.getGlobalPosition(); //[I-S]LN=32;[I-E]
         previousPosition = anchor.getGlobalPosition(); //[I-S]LN=33;[I-E]
         return; //[I-S]LN=34;[I-E]
       } else anchored = false; //[I-S]LN=35;[I-E]
    //[I-S]LN=36;[I-E]
       if (isFixed) return; //[I-S]LN=37;[I-E]
    //[I-S]LN=38;[I-E]
       Vector3 velocity = position.sub(previousPosition).mul(damping); //[I-S]LN=39;[I-E]
    //[I-S]LN=40;[I-E]
       // aplica air drag //[I-S]LN=41;[I-E]
         if(airdrag>0) //[I-S]LN=42;[I-E]
       velocity = velocity.mul(1 - airdrag * timeStep); //[I-S]LN=43;[I-E]
        //[I-S]LN=44;[I-E]
       Vector3 acceleration = accumulatedForce.mul(timeStep * timeStep); //[I-S]LN=45;[I-E]
       Vector3 next = position.sum(velocity).sum(acceleration); //[I-S]LN=46;[I-E]
       previousPosition = position; //[I-S]LN=47;[I-E]
       position = next; //[I-S]LN=48;[I-E]
       accumulatedForce.set(0, 0, 0); //[I-S]LN=49;[I-E]
       return; //[I-S]LN=50;[I-E]
     } //[I-S]LN=51;[I-E]
    //[I-S]LN=52;[I-E]
     if (myObject.exists() == true && rb != null) { //[I-S]LN=53;[I-E]
    //[I-S]LN=54;[I-E]
       position = myObject.getGlobalPosition(); //[I-S]LN=55;[I-E]
    //[I-S]LN=56;[I-E]
       // inicialização //[I-S]LN=57;[I-E]
       if (!initialized) { //[I-S]LN=58;[I-E]
         previousPosition = position; //[I-S]LN=59;[I-E]
         initialized = true; //[I-S]LN=60;[I-E]
         return; //[I-S]LN=61;[I-E]
       } //[I-S]LN=62;[I-E]
    //[I-S]LN=63;[I-E]
       if (anchor != null && anchor.exists()) { //[I-S]LN=64;[I-E]
         anchored = true; //[I-S]LN=65;[I-E]
         position = myObject.getGlobalPosition(); //[I-S]LN=66;[I-E]
         previousPosition = myObject.getGlobalPosition(); //[I-S]LN=67;[I-E]
         rb.setEnabled(false); //[I-S]LN=68;[I-E]
         myObject.getTransform().setIgnoreParent(false); //[I-S]LN=69;[I-E]
         myObject.setGlobalPosition(anchor.getGlobalPosition()); //[I-S]LN=70;[I-E]
         justReleased = true; //[I-S]LN=71;[I-E]
    //[I-S]LN=72;[I-E]
         return; //[I-S]LN=73;[I-E]
       } else { //[I-S]LN=74;[I-E]
         anchored = false; //[I-S]LN=75;[I-E]
         myObject.getTransform().setIgnoreParent(true); //[I-S]LN=76;[I-E]
       } //[I-S]LN=77;[I-E]
    //[I-S]LN=78;[I-E]
       if (isFixed) { //[I-S]LN=79;[I-E]
         rb.setEnabled(false); //[I-S]LN=80;[I-E]
    //[I-S]LN=81;[I-E]
         position = myObject.getGlobalPosition(); //[I-S]LN=82;[I-E]
         previousPosition = position; //[I-S]LN=83;[I-E]
    //[I-S]LN=84;[I-E]
         justReleased = true; //[I-S]LN=85;[I-E]
         return; //[I-S]LN=86;[I-E]
       } //[I-S]LN=87;[I-E]
       if (justReleased) { //[I-S]LN=88;[I-E]
         // não integra, não aplica solver, não calcula velocidade //[I-S]LN=89;[I-E]
         position = myObject.getGlobalPosition(); //[I-S]LN=90;[I-E]
         previousPosition = position; //[I-S]LN=91;[I-E]
    //[I-S]LN=92;[I-E]
         rb.setVelocity(0, 0, 0); //[I-S]LN=93;[I-E]
         accumulatedForce.set(0, 0, 0); //[I-S]LN=94;[I-E]
    //[I-S]LN=95;[I-E]
         rb.setEnabled(true); //[I-S]LN=96;[I-E]
    //[I-S]LN=97;[I-E]
         justReleased = false; //[I-S]LN=98;[I-E]
         return; //[I-S]LN=99;[I-E]
       } //[I-S]LN=100;[I-E]
    //[I-S]LN=101;[I-E]
       // 1. APLICAÇÃO DAS FORÇAS EXTERNAS (Vento, Gravidade Dinâmica, etc) //[I-S]LN=102;[I-E]
       // F = m * a   =>   a = F / m //[I-S]LN=103;[I-E]
       // deltaV = a * dt //[I-S]LN=104;[I-E]
    //[I-S]LN=105;[I-E]
       float mass = rb.getMass(); //[I-S]LN=106;[I-E]
       if (mass > 0.0001f) { //[I-S]LN=107;[I-E]
         // Calcula aceleração baseada na força acumulada //[I-S]LN=108;[I-E]
         Vector3 acceleration = accumulatedForce.mul(1f / mass); //[I-S]LN=109;[I-E]
    //[I-S]LN=110;[I-E]
         Vector3 deltaVelocity = acceleration.mul(timeStep); //[I-S]LN=111;[I-E]
         rb.addVelocity(deltaVelocity); //[I-S]LN=112;[I-E]
    //[I-S]LN=113;[I-E]
         if (airdrag > 0) { //[I-S]LN=114;[I-E]
           // aplica air drag //[I-S]LN=115;[I-E]
           Vector3 v = rb.getVelocity(); //[I-S]LN=116;[I-E]
           v = v.mul(1 - airdrag * timeStep); //[I-S]LN=117;[I-E]
           rb.setVelocity(v); //[I-S]LN=118;[I-E]
         }  //[I-S]LN=119;[I-E]
        //[I-S]LN=120;[I-E]
         // === ATUALIZA ESTADO === //[I-S]LN=121;[I-E]
         previousPosition = position; //[I-S]LN=122;[I-E]
         accumulatedForce.set(0, 0, 0); //[I-S]LN=123;[I-E]
       } //[I-S]LN=124;[I-E]
     } //[I-S]LN=125;[I-E]
   } //[I-S]LN=126;[I-E]
}